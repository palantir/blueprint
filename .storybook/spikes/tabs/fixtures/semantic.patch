diff --git a/packages/core/src/design-tokens/tokens/base/semantic.tokens.json b/packages/core/src/design-tokens/tokens/base/semantic.tokens.json
new file mode 100644
--- /dev/null
+++ b/packages/core/src/design-tokens/tokens/base/semantic.tokens.json
@@ -0,0 +1,34 @@
+{
+    "text": {
+        "$type": "color",
+        "normal": { "$value": "{palette.dark-gray.1}" },
+        "muted": { "$value": "{palette.gray.1}" }
+    },
+    "primary": {
+        "$type": "color",
+        "text": {
+            "normal": { "$value": "{palette.blue.2}" },
+            "strong": { "$value": "{palette.blue.1}" }
+        },
+        "background": {
+            "solid": {
+                "rest": { "$value": "{palette.blue.3}" }
+            },
+            "alpha": {
+                "overlay": {
+                    "selected": {
+                        "$value": "{primary.background.solid.rest}",
+                        "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
+                    }
+                }
+            }
+        }
+    },
+    "opacity": {
+        "$type": "number",
+        "disabled": {
+            "$value": 0.5,
+            "$description": "Apply once to the designated disabled foreground."
+        }
+    }
+}
