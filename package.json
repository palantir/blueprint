{
    "name": "@blueprintjs/root",
    "version": "0.0.0",
    "private": true,
    "description": "A React UI toolkit for the web.",
    "packageManager": "pnpm@11.3.0",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "bundle": "turbo run bundle",
        "compile": "turbo run compile",
        "clean": "turbo run clean",
        "copy:ci-config": "mkdir -p site/.circleci && cp .circleci/config-gh-pages.yml site/.circleci/config.yml",
        "copy:docs-app": "cp -rf packages/docs-app/dist/ site/docs",
        "copy:landing-app": "cp -rf packages/landing-app/dist/ site",
        "copy:storybook": "mkdir -p site/storybook && cp -rf storybook-static/. site/storybook/",
        "deploy:site": "gh-pages -d site -b gh-pages",
        "dev": "turbo run dev --concurrency=20 --filter=!@blueprintjs/landing-app --filter=!@blueprintjs/table-dev-app",
        "dev:core": "turbo run dev --filter=@blueprintjs/core --filter=@blueprintjs/icons --filter=@blueprintjs/docs-app",
        "dev:docs": "turbo run dev --filter=@blueprintjs/docs-app --filter=@blueprintjs/docs-theme",
        "dev:datetime": "turbo run dev --filter=@blueprintjs/datetime --filter=@blueprintjs/datetime2 --filter=@blueprintjs/docs-app",
        "dev:select": "turbo run dev --filter=@blueprintjs/select --filter=@blueprintjs/docs-app",
        "dev:table": "turbo run dev --filter=@blueprintjs/table --filter=@blueprintjs/table-dev-app",
        "dev:demo": "turbo run dev --filter=@blueprintjs/demo-app",
        "dist": "turbo run dist",
        "docs-data": "turbo run compile --filter=@blueprintjs/docs-data",
        "format": "prettier --write \"./**/*.{ts,tsx,mts,mjs,js,json,yaml,yml,scss,md}\"",
        "format-check": "prettier --check \"./**/*.{ts,tsx,mts,mjs,js,json,yaml,yml,scss,md}\"",
        "lint": "turbo run lint --continue",
        "lint-fix": "turbo run lint-fix",
        "serve": "http-server site",
        "site": "npm-run-all site:clean -p 'copy:*' -s serve",
        "site:clean": "git clean -xdfq site/",
        "test": "turbo run test --continue",
        "verify": "npm-run-all -s compile dist -p test lint format-check",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build --stats-json",
        "chromatic": "chromatic",
        "prepare": "husky"
    },
    "dependencies": {
        "@lerna-lite/cli": "^3.11.0",
        "@lerna-lite/version": "^3.11.0",
        "@types/enzyme": "~3.10.18",
        "@types/enzyme-adapter-react-16": "~1.0.9",
        "@types/node": "~24.12.2",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/react-transition-group": "~4.4.10",
        "@types/sinon": "~17.0.3",
        "@types/yargs": "~17.0.32",
        "@vitejs/plugin-react": "catalog:",
        "eslint": "^9.20.0",
        "gh-pages": "^6.3.0",
        "globals": "^15.14.0",
        "http-server": "^14.1.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.6.2",
        "sinon": "^17.0.1",
        "stylelint": "~16.25.0",
        "stylelint-config-palantir": "^7.6.0",
        "stylelint-scss": "^6.12.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.1",
        "vitest": "catalog:",
        "yargs": "^17.7.2"
    },
    "engines": {
        "pnpm": "11.3.0",
        "node": ">=24.14.1"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:palantir/blueprint.git"
    },
    "author": "Palantir Technologies",
    "license": "Apache-2.0",
    "lint-staged": {
        "*.{ts,tsx,mts,mjs,js,json,yaml,yml,scss,md}": "prettier --write --ignore-unknown",
        "*.{ts,tsx}": "eslint --fix --max-warnings 0",
        "*.scss": "stylelint --fix --custom-syntax postcss-scss"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "^10.2.14",
        "@storybook/addon-docs": "^10.2.14",
        "@storybook/addon-themes": "^10.2.14",
        "@storybook/react-dom-shim": "^10.2.14",
        "@storybook/react-vite": "^10.2.14",
        "@types/culori": "^4.0.1",
        "chromatic": "^16.0.0",
        "culori": "^4.0.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "storybook": "^10.2.14",
        "turbo": "~2.11.11",
        "vite": "^7.1.12"
    }
}
