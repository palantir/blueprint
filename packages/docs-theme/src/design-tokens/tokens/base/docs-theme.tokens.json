{
    "docs-theme": {
        "container-width": {
            "$type": "dimension",
            "$value": { "value": 1100, "unit": "px" }
        },
        "container-padding": {
            "$type": "dimension",
            "$value": { "value": 4, "unit": "px" }
        },
        "sidebar-width": {
            "$type": "dimension",
            "$value": { "value": 300, "unit": "px" }
        },
        "sidebar-padding": {
            "$type": "dimension",
            "$value": { "value": 16, "unit": "px" }
        },
        "sidebar-background-color": {
            "$type": "color",
            "$value": "{palette.white}"
        },
        "sidebar-divider-shadow": {
            "$type": "shadow",
            "$value": "1px 0 0 rgba(17, 20, 24, 0.15)"
        },
        "nav-background-shift": {
            "$type": "dimension",
            "$value": { "value": 999, "unit": "px" }
        },
        "content-width": {
            "$type": "dimension",
            "$value": { "value": 800, "unit": "px" }
        },
        "content-padding": {
            "$type": "dimension",
            "$value": { "value": 20, "unit": "px" }
        },
        "banner-height": {
            "$type": "dimension",
            "$value": { "value": 40, "unit": "px" }
        },
        "banner-shadow": {
            "$type": "shadow",
            "$value": "inset 0 -1px 0 rgba(17, 20, 24, 0.15)"
        },
        "heading-margin": {
            "$type": "dimension",
            "$value": { "value": 40, "unit": "px" }
        },
        "link-icon-padding": {
            "$type": "dimension",
            "$value": { "value": 8, "unit": "px" }
        },
        "class-modifier-color": {
            "$type": "color",
            "$value": "{palette.rose.4}"
        },
        "attribute-modifier-color": {
            "$type": "color",
            "$value": "{palette.violet.5}"
        },
        "example-frame-spacing": {
            "$type": "dimension",
            "$value": { "value": 8, "unit": "px" }
        },
        "example-frame-border-radius": {
            "$type": "dimension",
            "$value": "{border-radius}"
        },
        "example-spacing": {
            "$type": "dimension",
            "$value": { "value": 40, "unit": "px" }
        },
        "example-segmented-control-background-color": {
            "$type": "color",
            "$value": "{palette.light-gray.5}"
        },
        "nav-item-indent": {
            "$type": "dimension",
            "$value": { "value": 20, "unit": "px" }
        },
        "nav-divider-offset": {
            "$type": "dimension",
            "$value": { "value": 50, "unit": "px" }
        },
        "nav-button-hover-background-image": {
            "$type": "string",
            "$value": "linear-gradient(to right, rgba(246, 247, 249, 0) 0%, #f6f7f9 40%)"
        },
        "nav-divider-background-image": {
            "$type": "string",
            "$value": "linear-gradient(to right, rgba(17, 20, 24, 0) 0%, rgba(17, 20, 24, 0.15) 40%)"
        },
        "navigator-width": {
            "$type": "dimension",
            "$value": { "value": 400, "unit": "px" }
        },
        "required-prop-color": {
            "$type": "color",
            "$value": "{palette.green.3}"
        }
    }
}
