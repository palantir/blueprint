{
    "extends": "../../config/tsconfig.web",
    "compilerOptions": {
        "outDir": "../lib/esm",
        "moduleResolution": "bundler",
        "skipLibCheck": true // Avoiding type conflicts with @types/chai in root vs vitest
    },
    "include": ["src/**/*", "src/**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"],
    "exclude": ["vitest.config.ts", "vitest.setup.ts", "node_modules"]
}
