{
    "$schema": "../../node_modules/turbo/schema.json",
    "extends": ["//"],
    // Icon scripts and tests read the repo-root resources/icons.
    "tasks": {
        "compile": { "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icons/**"] },
        "test": { "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icons/**"] },
        "test:iso": { "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icons/**"] },
        "icons:verify": { "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icons/**"], "outputs": [] },
        "generate-icon-src": {
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icons/**"],
            "outputs": ["src/generated/**", "src/next/generated/**"]
        },
        // Needs only generated sources, so CI can run it alongside compile.
        "test:typeCheck": {
            "dependsOn": ["^compile", "icons:verify", "generate-icon-src"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icons/**"]
        },
        "test:vitest:run": { "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resources/icons/**"] }
    }
}
