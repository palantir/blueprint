{
    "docs-app": {
        "palette-spacing": {
            "$type": "dimension",
            "$value": { "value": 20, "unit": "px" }
        },
        "palette-border-radius": {
            "$type": "dimension",
            "$value": "{border-radius}"
        },
        "palette-unselected-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 0 rgba(45, 114, 210, 0)"
        },
        "palette-selected-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 2px #2d72d2"
        },
        "color-bar-focus-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 1px rgba(17, 20, 24, 0.1), 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 15px -3px rgba(0, 0, 0, 0.1)"
        },
        "color-bar-pre-box-shadow": {
            "$type": "shadow",
            "$value": "{code-box-shadow}"
        },
        "section-card-margin-bottom": {
            "$type": "dimension",
            "$value": { "value": 0, "unit": "px" }
        },
        "swatch-height": {
            "$type": "dimension",
            "$value": "{control-height-large}"
        },
        "swatch-hover-offset": {
            "$type": "dimension",
            "$value": { "value": -4, "unit": "px" }
        },
        "swatch-border-color": {
            "$type": "color",
            "$value": "rgba(17, 20, 24, 0.2)"
        },
        "swatch-hover-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(17, 20, 24, 0.2), 0 2px 4px rgba(17, 20, 24, 0.1), 0 8px 24px rgba(17, 20, 24, 0.2)"
        },
        "swatch-active-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(17, 20, 24, 0.2), 0 1px 1px rgba(17, 20, 24, 0.2)"
        },
        "bubble-size": {
            "$type": "dimension",
            "$value": { "value": 20, "unit": "px" }
        },
        "bubble-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(17, 20, 24, 0.15)"
        },
        "svg-icon-size": {
            "$type": "dimension",
            "$value": { "value": 36, "unit": "px" }
        },
        "hover-transition": {
            "$type": "string",
            "$value": "100ms cubic-bezier(0.4, 1, 0.75, 0.9)"
        },
        "icon-next-rail-width": {
            "$type": "dimension",
            "$value": { "value": 120, "unit": "px" }
        },
        "icon-next-columns": {
            "$type": "number",
            "$value": 6
        },
        "icons-per-row": {
            "$type": "number",
            "$value": 5
        },
        "icon-browser-background-color-hover": {
            "$type": "color",
            "$value": "{palette.light-gray.4}"
        },
        "icon-browser-background-color-active": {
            "$type": "color",
            "$value": "{palette.light-gray.3}"
        },
        "icon-dialog-hero-background-color": {
            "$type": "color",
            "$value": "{palette.white}"
        },
        "package-icon-width": {
            "$type": "dimension",
            "$value": { "value": 24, "unit": "px" }
        },
        "logo-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.5}"
        },
        "card-elevation-example-background-color": {
            "$type": "color",
            "$value": "{palette.white}"
        },
        "context-menu-node-background-color": {
            "$type": "color",
            "$value": "{palette.blue.5}"
        },
        "context-menu-node-size": {
            "$type": "dimension",
            "$value": { "value": 80, "unit": "px" }
        },
        "context-menu-icon-size": {
            "$type": "dimension",
            "$value": { "value": 32, "unit": "px" }
        },
        "context-menu-node-border-width": {
            "$type": "dimension",
            "$value": { "value": 4, "unit": "px" }
        },
        "hotkey-piano-height": {
            "$type": "dimension",
            "$value": { "value": 510, "unit": "px" }
        },
        "hotkey-tester-background-color": {
            "$type": "color",
            "$value": "rgba(143, 153, 168, 0.2)"
        },
        "hotkey-tester-border-color": {
            "$type": "color",
            "$value": "rgba(143, 153, 168, 0.8)"
        },
        "hotkey-tester-focus-background-color": {
            "$type": "color",
            "$value": "rgba(45, 114, 210, 0.1)"
        },
        "hotkey-tester-focus-border-color": {
            "$type": "color",
            "$value": "rgba(45, 114, 210, 0.6)"
        },
        "hotkey-tester-focus-text-color": {
            "$type": "color",
            "$value": "{palette.blue.2}"
        },
        "panel-stack-shadow": {
            "$type": "shadow",
            "$value": "{elevation.shadow.0}"
        },
        "popover-placement-muted-color": {
            "$type": "color",
            "$value": "inherit"
        },
        "popover-placement-side-color": {
            "$type": "color",
            "$value": "{palette.cerulean.3}"
        },
        "popover-placement-alignment-color": {
            "$type": "color",
            "$value": "{palette.forest.3}"
        },
        "popover-portal-scroll-background-color": {
            "$type": "color",
            "$value": "{palette.light-gray.3}"
        },
        "popover-portal-target-plus-popover-height": {
            "$type": "dimension",
            "$value": { "value": 85, "unit": "px" }
        },
        "popover-portal-vertical-padding": {
            "$type": "dimension",
            "$value": { "value": 20, "unit": "px" }
        },
        "overlay-example-width": {
            "$type": "dimension",
            "$value": { "value": 400, "unit": "px" }
        },
        "datepicker-odd-day-color": {
            "$type": "color",
            "$value": "{palette.red.2}"
        }
    }
}
