{
    "docs-app": {
        "color-alias": {
            "$type": "color",
            "intent-primary": { "$value": "{intent.primary.rest}" },
            "intent-success": { "$value": "{intent.success.rest}" },
            "intent-warning": { "$value": "{intent.warning.rest}" },
            "intent-danger": { "$value": "{intent.danger.rest}" },
            "app-background-color": { "$value": "{palette.light-gray.5}" },
            "dark-app-background-color": { "$value": "{palette.dark-gray.1}" },
            "text-color": { "$value": "{palette.dark-gray.1}" },
            "text-color-muted": { "$value": "{palette.gray.1}" },
            "text-color-disabled": { "$value": "rgba(95, 107, 124, 0.6)" },
            "heading-color": { "$value": "{palette.dark-gray.1}" },
            "link-color": { "$value": "{palette.blue.2}" },
            "dark-text-color": { "$value": "{palette.light-gray.5}" },
            "dark-text-color-muted": { "$value": "{palette.gray.4}" },
            "dark-text-color-disabled": { "$value": "rgba(171, 179, 191, 0.6)" },
            "dark-heading-color": { "$value": "{palette.light-gray.5}" },
            "dark-link-color": { "$value": "{palette.blue.5}" },
            "text-selection-color": { "$value": "rgba(125, 188, 255, 0.6)" },
            "icon-color": { "$value": "{palette.gray.1}" },
            "icon-color-hover": { "$value": "{palette.dark-gray.1}" },
            "icon-color-disabled": { "$value": "rgba(95, 107, 124, 0.6)" },
            "icon-color-selected": { "$value": "{intent.primary.rest}" },
            "dark-icon-color": { "$value": "{palette.gray.4}" },
            "dark-icon-color-hover": { "$value": "{palette.light-gray.5}" },
            "dark-icon-color-disabled": { "$value": "rgba(171, 179, 191, 0.6)" },
            "dark-icon-color-selected": { "$value": "{intent.primary.rest}" },
            "divider-black": { "$value": "rgba(17, 20, 24, 0.15)" },
            "dark-divider-black": { "$value": "rgba(17, 20, 24, 0.4)" },
            "dark-divider-white": { "$value": "rgba(255, 255, 255, 0.2)" },
            "code-text-color": { "$value": "{palette.gray.1}" },
            "dark-code-text-color": { "$value": "{palette.gray.4}" },
            "code-background-color": { "$value": "rgba(255, 255, 255, 0.7)" },
            "dark-code-background-color": { "$value": "rgba(17, 20, 24, 0.3)" }
        }
    }
}
