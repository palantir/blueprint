{
    "docs-app": {
        "color-bar-pre-box-shadow": {
            "$type": "shadow",
            "$value": "none"
        },
        "section-card-margin-bottom": {
            "$type": "dimension",
            "$value": { "value": 1, "unit": "px" }
        },
        "swatch-border-color": {
            "$type": "color",
            "$value": "rgba(255, 255, 255, 0.2)"
        },
        "swatch-hover-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(255, 255, 255, 0.2), 0 2px 4px rgba(17, 20, 24, 0.2), 0 8px 24px rgba(17, 20, 24, 0.4)"
        },
        "swatch-active-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(255, 255, 255, 0.2), 0 1px 1px rgba(17, 20, 24, 0.4)"
        },
        "bubble-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(255, 255, 255, 0.2)"
        },
        "icon-browser-background-color-hover": {
            "$type": "color",
            "$value": "{palette.dark-gray.3}"
        },
        "icon-browser-background-color-active": {
            "$type": "color",
            "$value": "{palette.dark-gray.2}"
        },
        "icon-dialog-hero-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.3}"
        },
        "logo-color": {
            "$type": "color",
            "$value": "{palette.gray.5}"
        },
        "card-elevation-example-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.3}"
        },
        "context-menu-node-background-color": {
            "$type": "color",
            "$value": "{palette.blue.2}"
        },
        "hotkey-tester-focus-background-color": {
            "$type": "color",
            "$value": "rgba(76, 144, 240, 0.1)"
        },
        "hotkey-tester-focus-border-color": {
            "$type": "color",
            "$value": "rgba(76, 144, 240, 0.6)"
        },
        "hotkey-tester-focus-text-color": {
            "$type": "color",
            "$value": "{palette.blue.5}"
        },
        "panel-stack-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 1px rgba(255, 255, 255, 0.2)"
        },
        "popover-placement-muted-color": {
            "$type": "color",
            "$value": "{text-color-muted}"
        },
        "popover-placement-side-color": {
            "$type": "color",
            "$value": "{palette.cerulean.5}"
        },
        "popover-placement-alignment-color": {
            "$type": "color",
            "$value": "{palette.forest.5}"
        },
        "popover-portal-scroll-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.5}"
        },
        "datepicker-odd-day-color": {
            "$type": "color",
            "$value": "{palette.red.4}"
        }
    }
}
