{
    "$schema": "../../node_modules/turbo/schema.json",
    "extends": ["//"],
    "tasks": {
        "bundle": { "cache": false },
        "dist": {
            // docs-data documents datetime2, which isn't a docs-app dependency, so its sources aren't otherwise hashed
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/datetime2/src/**"]
        }
    }
}
