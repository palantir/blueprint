{
    "intent": {
        "$type": "color",
        "$description": "Semantic intent colors with interaction states and foreground",
        "default": {
            "rest": { "$value": "{palette.gray.700}" },
            "hover": { "$value": "{palette.gray.600}" },
            "active": { "$value": "{palette.gray.800}" },
            "disabled": { "$value": "{palette.gray.400}" },
            "foreground": { "$value": "{palette.gray.100}" }
        },
        "primary": {
            "rest": { "$value": "{palette.blue.500}", "$description": "Primary rest state" },
            "hover": { "$value": "{palette.blue.400}" },
            "active": { "$value": "{palette.blue.600}" },
            "disabled": { "$value": "{palette.blue.300}" },
            "foreground": {
                "$value": "{palette.gray.100}",
                "$description": "Contrast-compliant color on primary background"
            }
        },
        "success": {
            "rest": { "$value": "{palette.green.500}" },
            "hover": { "$value": "{palette.green.400}" },
            "active": { "$value": "{palette.green.600}" },
            "disabled": { "$value": "{palette.green.300}" },
            "foreground": { "$value": "{palette.gray.100}" }
        },
        "warning": {
            "rest": { "$value": "{palette.orange.500}" },
            "hover": { "$value": "{palette.orange.400}" },
            "active": { "$value": "{palette.orange.600}" },
            "disabled": { "$value": "{palette.orange.300}" },
            "foreground": { "$value": "{palette.gray.100}" }
        },
        "danger": {
            "rest": { "$value": "{palette.red.500}" },
            "hover": { "$value": "{palette.red.400}" },
            "active": { "$value": "{palette.red.600}" },
            "disabled": { "$value": "{palette.red.300}" },
            "foreground": { "$value": "{palette.gray.100}" }
        }
    }
}
