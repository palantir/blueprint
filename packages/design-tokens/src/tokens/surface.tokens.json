{
    "surface": {
        "borderColor": {
            "$type": "color",
            "default": {
                "$value": "{intent.default.rest}",
                "$extensions": {
                    "com.blueprint.derive": { "alpha": 0.12 }
                }
            },
            "strong": {
                "$value": "{intent.default.rest}",
                "$extensions": {
                    "com.blueprint.derive": { "alpha": 0.25 }
                }
            }
        },
        "borderWidth": {
            "$type": "dimension",
            "$value": { "value": 1, "unit": "px" }
        },
        "borderRadius": {
            "$type": "dimension",
            "$value": { "value": 4, "unit": "px" }
        },
        "shadow": {
            "$type": "shadow",
            "$description": "Elevation shadows with multiple layers. Light mode base values.",
            "0": {
                "$description": "Card elevation (100-card)",
                "$value": [
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 0, "unit": "px" },
                        "blur": { "value": 5, "unit": "px" },
                        "spread": { "value": 0, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.1 }
                    }
                ]
            },
            "1": {
                "$description": "Interactive elevation (200-interactive)",
                "$value": [
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 1, "unit": "px" },
                        "blur": { "value": 3, "unit": "px" },
                        "spread": { "value": 0, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.2 }
                    },
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 1, "unit": "px" },
                        "blur": { "value": 2, "unit": "px" },
                        "spread": { "value": -1, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.2 }
                    }
                ]
            },
            "2": {
                "$description": "Tooltip elevation (300-tooltip)",
                "$value": [
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 4, "unit": "px" },
                        "blur": { "value": 6, "unit": "px" },
                        "spread": { "value": -4, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.2 }
                    },
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 10, "unit": "px" },
                        "blur": { "value": 15, "unit": "px" },
                        "spread": { "value": -3, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.2 }
                    }
                ]
            },
            "3": {
                "$description": "Panel elevation (400-panel)",
                "$value": [
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 20, "unit": "px" },
                        "blur": { "value": 25, "unit": "px" },
                        "spread": { "value": -5, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.2 }
                    },
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 10, "unit": "px" },
                        "blur": { "value": 15, "unit": "px" },
                        "spread": { "value": -3, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.2 }
                    }
                ]
            },
            "4": {
                "$description": "Modal elevation (500-modal)",
                "$value": [
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 25, "unit": "px" },
                        "blur": { "value": 50, "unit": "px" },
                        "spread": { "value": -12, "unit": "px" },
                        "color": { "colorSpace": "oklch", "components": [0, 0, 0], "alpha": 0.4 }
                    }
                ]
            }
        },
        "spacing": {
            "$type": "dimension",
            "$value": { "value": 4, "unit": "px" },
            "$description": "Base spacing unit — components multiply this"
        },
        "zIndex": {
            "$type": "number",
            "0": { "$value": 0 },
            "1": { "$value": 10 },
            "2": { "$value": 20 },
            "3": { "$value": 30 },
            "4": { "$value": 40 }
        },
        "colorCode": {
            "$type": "color",
            "$value": { "colorSpace": "oklch", "components": [0.95, 0.01, 264], "hex": "#f5f5f5" }
        },
        "colorRest": {
            "$type": "color",
            "default": { "$value": "{palette.gray.100}" },
            "primary": { "$value": "{intent.primary.rest}" },
            "success": { "$value": "{intent.success.rest}" },
            "warning": { "$value": "{intent.warning.rest}" },
            "danger": { "$value": "{intent.danger.rest}" }
        },
        "colorHover": {
            "$type": "color",
            "default": { "$value": "{palette.gray.200}" },
            "primary": { "$value": "{intent.primary.hover}" },
            "success": { "$value": "{intent.success.hover}" },
            "warning": { "$value": "{intent.warning.hover}" },
            "danger": { "$value": "{intent.danger.hover}" }
        },
        "colorActive": {
            "$type": "color",
            "default": { "$value": "{palette.gray.300}" },
            "primary": { "$value": "{intent.primary.active}" },
            "success": { "$value": "{intent.success.active}" },
            "warning": { "$value": "{intent.warning.active}" },
            "danger": { "$value": "{intent.danger.active}" }
        },
        "colorDisabled": {
            "$type": "color",
            "default": { "$value": "{palette.gray.100}" },
            "primary": { "$value": "{intent.primary.disabled}" },
            "success": { "$value": "{intent.success.disabled}" },
            "warning": { "$value": "{intent.warning.disabled}" },
            "danger": { "$value": "{intent.danger.disabled}" }
        },
        "depthLayer": {
            "$type": "color",
            "$description": "Transparent overlay for elevated surfaces at 5% opacity",
            "default": {
                "$value": "{intent.default.rest}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.05 } }
            },
            "primary": {
                "$value": "{intent.primary.rest}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.05 } }
            },
            "success": {
                "$value": "{intent.success.rest}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.05 } }
            },
            "warning": {
                "$value": "{intent.warning.rest}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.05 } }
            },
            "danger": {
                "$value": "{intent.danger.rest}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.05 } }
            }
        }
    }
}
