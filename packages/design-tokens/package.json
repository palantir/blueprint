{
    "name": "@blueprintjs/design-tokens",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Build tool for Blueprint design tokens - colors, typography, spacing, and more",
    "main": "lib/cjs/index.js",
    "module": "lib/esm/index.js",
    "esnext": "lib/esnext/index.js",
    "typings": "lib/esm/index.d.ts",
    "files": [
        "lib",
        "src"
    ],
    "scripts": {
        "clean": "rm -rf lib/*",
        "build": "node --experimental-strip-types src/build.ts",
        "compile": "pnpm run build && cp lib/css/*.css ../labs/lib/css/",
        "lint": "es-lint",
        "verify": "npm-run-all compile lint"
    },
    "dependencies": {
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@blueprintjs/node-build-scripts": "workspace:^",
        "@tokens-studio/sd-transforms": "^2.0.3",
        "glob": "^11.0.0",
        "npm-run-all": "^4.1.5",
        "style-dictionary": "^5.0.3",
        "typescript": "~5.3.3"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:palantir/blueprint.git",
        "directory": "packages/design-tokens"
    },
    "author": "Palantir Technologies",
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.19.0"
}
