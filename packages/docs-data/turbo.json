{
    "$schema": "../../node_modules/turbo/schema.json",
    "extends": ["//"],
    "tasks": {
        // Cached on the repo sources documentalist reads. npm-data.json is excluded from outputs so a
        // cache hit never replaces the copy fetched fresh by compile:npm-data.
        "compile": {
            "dependsOn": ["^compile", "compile:npm-data"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/packages/*/src/**/*.{md,mdx,ts,tsx,scss}",
                "$TURBO_ROOT$/packages/*/package.json",
                // icons' generated sources are covered by the icons#compile hash (via ^compile)
                "!$TURBO_ROOT$/packages/icons/src/**/generated/**"
            ],
            "outputs": ["src/generated/**", "!src/generated/npm-data.json"]
        },
        "compile:docs": { "dependsOn": ["^compile"], "cache": false },
        // Fetches live npm metadata, so it must always run.
        "compile:npm-data": { "cache": false },
        // Tests load src/index.js, which requires src/generated. navRoutes.test.ts checks every package's
        // .mdx pages against nav.json.
        "test": {
            "dependsOn": ["compile"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**/*.mdx"]
        },
        "test:vitest:run": {
            "dependsOn": ["compile"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/**/*.mdx"]
        }
    }
}
