{
    "name": "@blueprintjs/docs-data",
    "version": "6.5.1",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "private": true,
    "scripts": {
        "clean": "rm -rf src/generated/* || true",
        "compile": "node ./compile-docs-data.mjs"
    },
    "nx": {
        "targets": {
            "compile": {
                "inputs": [
                    "{workspaceRoot}/packages/*/src/**/*.mdx",
                    "{workspaceRoot}/packages/*/package.json",
                    "{projectRoot}/*.mjs",
                    "{projectRoot}/nav.json"
                ],
                "outputs": [
                    "{projectRoot}/src/generated"
                ]
            }
        }
    },
    "dependencies": {
        "react": "^18.3.1",
        "semver": "^7.7.3"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:palantir/blueprint.git",
        "directory": "packages/docs-data"
    },
    "author": "Palantir Technologies",
    "license": "Apache-2.0"
}
