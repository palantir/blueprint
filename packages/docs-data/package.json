{
    "name": "@blueprintjs/docs-data",
    "version": "6.5.1",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "private": true,
    "scripts": {
        "clean": "rm -rf src/generated",
        "compile": "tsx ./compile-docs-data.mts",
        "compile:docs": "tsx ./compile-docs-data.mts docs",
        "compile:npm-data": "tsx ./compile-docs-data.mts npm",
        "test": "vitest run",
        "test:vitest": "vitest",
        "test:vitest:run": "vitest run"
    },
    "nx": {
        "targets": {
            "compile": {
                "cache": false,
                "inputs": [
                    "{workspaceRoot}/packages/*/src/**/*.{md,mdx,ts,tsx,scss}",
                    "{workspaceRoot}/packages/*/package.json",
                    "{workspaceRoot}/config/tsconfig*.json",
                    "{projectRoot}/*.{mjs,mts}",
                    "{projectRoot}/typescript/**/*.{ts,json}",
                    "{projectRoot}/nav.json"
                ],
                "outputs": [
                    "{projectRoot}/src/generated"
                ]
            },
            "compile:docs": {
                "cache": false,
                "dependsOn": [
                    "^compile"
                ],
                "outputs": [
                    "{projectRoot}/src/generated/docs.json",
                    "{projectRoot}/src/generated/nav-constants.js"
                ]
            },
            "compile:npm-data": {
                "cache": false,
                "dependsOn": [
                    "^compile"
                ],
                "outputs": [
                    "{projectRoot}/src/generated/npm-data.json"
                ]
            }
        }
    },
    "dependencies": {
        "@blueprintjs/core": "workspace:^",
        "@blueprintjs/docs-theme": "workspace:^",
        "@documentalist/compiler": "^5.0.0",
        "escape-html": "^1.0.3",
        "marked": "^9.1.6",
        "package-json": "^10.0.1",
        "semver": "^7.5.4"
    },
    "devDependencies": {
        "@blueprintjs/test-commons": "workspace:^",
        "tsx": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:palantir/blueprint.git",
        "directory": "packages/docs-data"
    },
    "author": "Palantir Technologies",
    "license": "Apache-2.0"
}
