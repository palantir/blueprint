{
    "name": "@blueprintjs/docs-data",
    "version": "6.5.1",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "private": true,
    "scripts": {
        "clean": "rm -rf src/generated/* || true",
        "compile": "run-p compile:docs compile:props",
        "compile:docs": "node ./compile-docs-data.mjs",
        "compile:props": "node ./compile-props-data.mjs"
    },
    "nx": {
        "targets": {
            "compile": {
                "inputs": [
                    "{workspaceRoot}/packages/*/src/**/*.{md,ts,tsx,scss}",
                    "{workspaceRoot}/packages/*/package.json",
                    "{projectRoot}/*.mjs",
                    "{projectRoot}/nav.json"
                ],
                "outputs": [
                    "{projectRoot}/src/generated"
                ]
            }
        }
    },
    "dependencies": {
        "semver": "^7.5.4"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:palantir/blueprint.git",
        "directory": "packages/docs-data"
    },
    "author": "Palantir Technologies",
    "license": "Apache-2.0",
    "devDependencies": {
        "glob": "^10.5.0",
        "react-docgen-typescript": "^2.4.0"
    }
}
