+      height: calc($arrow-square-size / 1.41421356 - var(--bp-surface-border-width));
+      margin: calc(($arrow-square-size - $arrow-square-size / 1.41421356) / 2);
+      width: calc($arrow-square-size / 1.41421356 - var(--bp-surface-border-width));
     }
   }
 }
 
