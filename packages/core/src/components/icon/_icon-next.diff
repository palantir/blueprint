-      stroke-opacity: 0.5;
-      stroke-width: 0.5px;
+      stroke: var(--bp-surface-divider-color-strong);
+      stroke-opacity: 1;
+      stroke-width: calc(var(--bp-surface-border-width) * 0.5);
     }
   }
+}
 
-  .#{$ns}-dark & {
-    .#{$ns}-icon-muted svg {
-      fill-opacity: 0.2;
+// intent colors for both SVG and font icons are overridden below so they respond to BP7 token customization
