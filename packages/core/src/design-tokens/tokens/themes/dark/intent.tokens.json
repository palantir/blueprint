{
  "intent": {
    "$type": "color",
    "$description": "Dark mode intent colors - lighter shades for contrast on dark backgrounds",
    "default": {
      "rest": { "$value": "{palette.gray.4}" },
      "hover": { "$value": "{palette.light-gray.1}" },
      "active": { "$value": "{palette.light-gray.2}" },
      "disabled": { "$value": "{palette.gray.2}" },
      "foreground": { "$value": "{palette.black}" }
    },
    "primary": {
      "rest": { "$value": "{palette.blue.4}" },
      "hover": { "$value": "{palette.blue.5}" },
      "active": { "$value": "{palette.blue.5}" },
