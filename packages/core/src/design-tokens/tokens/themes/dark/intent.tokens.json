{
    "intent": {
        "$type": "color",
        "$description": "Dark-scoped semantic intent aliases; all functional roles are rebound so they resolve against the dark primitives.",
        "neutral": {
            "background": {
                "rest": { "$value": "{color.grey.3}" },
                "hover": { "$value": "{color.grey.4}" },
                "active": { "$value": "{color.grey.5}" },
                "subtle": {
                    "$value": "{color.grey.2}"
                },
                "disabled-active": {
                    "$value": "color-mix(in srgb, {intent.default.disabled} 30%, transparent)"
                }
            },
            "border": {
                "rest": { "$value": "{color.grey.7}" },
                "hover": { "$value": "{color.grey.8}" },
                "disabled": { "$value": "{surface.border-color.default}" },
                "subtle": {
                    "$value": "{color.grey.6}"
                }
            },
            "solid": {
                "disabled": { "$value": "color-mix(in srgb, {intent.default.disabled} 4%, transparent)" },
                "disabled-active": { "$value": "color-mix(in srgb, {intent.default.disabled} 7%, transparent)" },
                "foreground-disabled": { "$value": "{typography.color-default.disabled}" },
                "rest": {
                    "$value": "{color.grey.9}"
                },
                "hover": {
                    "$value": "{color.grey.10}"
                },
                "active": {
                    "$value": "{color.grey.11}"
                },
                "foreground": {
                    "$value": "{color.grey.contrast}"
                }
            }
        },
        "default": {
            "border": {
                "disabled": {
                    "$value": "color-mix(in oklch, color-mix(in srgb, {intent.default.rest} 46%, {palette.white}) 20%, transparent)"
                }
            },
            "solid": {
                "foreground-disabled": {
                    "$value": "color-mix(in oklch, {intent.default.foreground} 30%, transparent)"
                },
                "disabled": {
                    "$value": "color-mix(in oklch, {intent.default.rest} 50%, transparent)"
                }
            },
            "background": {
                "disabled-active": {
                    "$value": "color-mix(in oklch, {intent.default.rest} 30%, transparent)"
                }
            },
            "rest": {
                "$value": "{palette.gray.1}"
            },
            "hover": {
                "$value": "{palette.dark-gray.5}"
            },
            "active": {
                "$value": "{palette.dark-gray.4}"
            },
            "disabled": {
                "$value": "{palette.gray.3}"
            },
            "foreground": {
                "$value": "{palette.white}"
            }
        },
        "primary": {
            "background": {
                "hover": { "$value": "{color.blue.4}" },
                "active": { "$value": "{color.blue.5}" },
                "subtle": {
                    "$value": "{color.blue.2}"
                },
                "rest": {
                    "$value": "{color.blue.3}"
                },
                "disabled-active": {
                    "$value": "color-mix(in oklch, {intent.primary.rest} 30%, transparent)"
                }
            },
            "border": {
                "rest": { "$value": "{color.blue.7}" },
                "hover": { "$value": "{color.blue.8}" },
                "disabled": {
                    "$value": "color-mix(in oklch, color-mix(in oklch, {intent.primary.rest} 51%, {palette.white}) 20%, transparent)"
                },
                "subtle": {
                    "$value": "{color.blue.6}"
                }
            },
            "solid": {
                "rest": { "$value": "{color.blue.9}" },
                "hover": { "$value": "{color.blue.10}" },
                "active": { "$value": "{color.blue.11}" },
                "foreground": { "$value": "{color.blue.contrast}" },
                "foreground-disabled": {
                    "$value": "color-mix(in oklch, {intent.default.foreground} 30%, transparent)"
                },
                "disabled": {
                    "$value": "color-mix(in oklch, {intent.primary.rest} 50%, transparent)"
                }
            },
            "rest": {
                "$value": "{palette.blue.3}"
            },
            "hover": {
                "$value": "{palette.blue.2}"
            },
            "active": {
                "$value": "{palette.blue.1}"
            },
            "disabled": {
                "$value": "{palette.blue.4}"
            },
            "foreground": {
                "$value": "{palette.white}"
