{
    "border": {
        "color-intent": {
            "$type": "color",
            "primary": {
                "$value": "color-mix(in oklch, var(--bp-intent-primary-rest) 51%, var(--bp-palette-white))"
            },
            "success": {
                "$value": "color-mix(in oklch, var(--bp-intent-success-rest) 54%, var(--bp-palette-white))"
            },
            "warning": {
                "$value": "color-mix(in oklch, var(--bp-intent-warning-rest) 53%, var(--bp-palette-white))"
            },
            "danger": {
                "$value": "color-mix(in oklch, var(--bp-intent-danger-rest) 53%, var(--bp-palette-white))"
            },
            "default": {
                "$value": "color-mix(in srgb, var(--bp-intent-default-rest) 46%, var(--bp-palette-white))"
            }
        }
    }
}
