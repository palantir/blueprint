                    "$value": "color-mix(in oklch, {intent.default.foreground} 30%, transparent)"
                },
                "disabled": {
                    "$value": "color-mix(in oklch, {intent.success.rest} 50%, transparent)"
                }
            },
            "rest": {
                "$value": "{palette.green.3}"
            },
            "hover": {
                "$value": "{palette.green.2}"
            },
            "active": {
                "$value": "{palette.green.1}"
            },
            "disabled": {
                "$value": "{palette.green.4}"
            },
            "foreground": {
                "$value": "{palette.white}"
            }
        },
        "warning": {
