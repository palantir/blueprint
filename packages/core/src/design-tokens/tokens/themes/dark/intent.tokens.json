{
    "intent": {
        "$type": "color",
        "default": {
            "text": { "$value": "{palette.light-gray.5}" },
            "text-hover": { "$value": "{palette.white}" },
            "text-active": { "$value": "{palette.light-gray.4}" },
            "text-muted": { "$value": "{palette.gray.4}" },
            "text-disabled": {
                "$value": "{intent.default.text-muted}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
            }
        },
        "primary": {
            "text": { "$value": "{palette.blue.5}" },
            "text-active": { "$value": "{palette.blue.6}" }
        },
        "success": {
            "text": { "$value": "{palette.green.5}" },
            "text-active": { "$value": "{palette.green.6}" }
        },
        "warning": {
            "text": { "$value": "{palette.orange.5}" },
            "text-active": { "$value": "{palette.orange.6}" }
        },
        "danger": {
            "text": { "$value": "{palette.red.5}" },
            "text-active": { "$value": "{palette.red.6}" }
        }
    }
}
