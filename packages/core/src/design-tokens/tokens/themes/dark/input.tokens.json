{
    "input": {
        "background": {
            "$type": "color",
            "rest": { "$value": "{surface.background-color.default.rest}" },
            "disabled": { "$value": "{surface.background-color.default.disabled}" }
        },
        "foreground": {
            "$type": "color",
            "rest": { "$value": "{typography.color-default.rest}" },
            "disabled": {
                "$value": "{typography.color-muted}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
            },
            "placeholder": { "$value": "{typography.color-muted}" }
        },
        "shadow": {
            "$type": "string",
            "rest": {
                "$value": "0 0 0 0 rgba(138, 187, 255, 0), 0 0 0 0 rgba(138, 187, 255, 0), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
            },
            "focus": {
                "$value": "inset 0 0 0 1px rgba(138, 187, 255, 0.752), 0 0 0 1px rgba(138, 187, 255, 0.752)"
            },
            "readonly": {
                "$value": "inset 0 0 0 1px rgba(17, 20, 24, 0.4)"
            },
            "intent": {
                "primary": {
                    "rest": {
                        "$value": "0 0 0 0 rgba(76, 144, 240, 0), 0 0 0 0 rgba(76, 144, 240, 0), inset 0 0 0 1px #4c90f0, inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "focus": {
                        "$value": "inset 0 0 0 1px rgba(76, 144, 240, 0.752), 0 0 0 2px rgba(76, 144, 240, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "readonly": {
                        "$value": "inset 0 0 0 1px #4c90f0"
                    }
                },
                "success": {
                    "rest": {
                        "$value": "0 0 0 0 rgba(50, 164, 103, 0), 0 0 0 0 rgba(50, 164, 103, 0), inset 0 0 0 1px #32a467, inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "focus": {
                        "$value": "inset 0 0 0 1px rgba(50, 164, 103, 0.752), 0 0 0 2px rgba(50, 164, 103, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "readonly": {
                        "$value": "inset 0 0 0 1px #32a467"
                    }
                },
                "warning": {
                    "rest": {
                        "$value": "0 0 0 0 rgba(236, 154, 60, 0), 0 0 0 0 rgba(236, 154, 60, 0), inset 0 0 0 1px #ec9a3c, inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "focus": {
                        "$value": "inset 0 0 0 1px rgba(236, 154, 60, 0.752), 0 0 0 2px rgba(236, 154, 60, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "readonly": {
                        "$value": "inset 0 0 0 1px #ec9a3c"
                    }
                },
                "danger": {
                    "rest": {
                        "$value": "0 0 0 0 rgba(231, 106, 110, 0), 0 0 0 0 rgba(231, 106, 110, 0), inset 0 0 0 1px #e76a6e, inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "focus": {
                        "$value": "inset 0 0 0 1px rgba(231, 106, 110, 0.752), 0 0 0 2px rgba(231, 106, 110, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                    },
                    "readonly": {
                        "$value": "inset 0 0 0 1px #e76a6e"
                    }
                }
            }
        }
    }
}
