{
    "primary": {
        "$type": "color",
        "text": {
            "on-solid-disabled": {
                "$value": "{primary.text.on-solid}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
            },
            "disabled": {
                "$value": "{primary.text.normal}",
                "$extensions": { "com.blueprint.derive": { "alpha": "{opacity.disabled}" } }
            }
        },
        "border": {
            "alpha": {
                "rest": {
                    "$value": "{primary.text.normal}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                },
                "disabled": {
                    "$value": "{primary.text.normal}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                }
            }
        },
        "background": {
            "solid": {
                "disabled": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": "{opacity.disabled}" } }
                }
            },
            "alpha": {
                "subtle": {
                    "rest": {
                        "$value": "{primary.base}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                    },
                    "hover": {
                        "$value": "{primary.base}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                    },
                    "active": {
                        "$value": "{primary.base}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.35 } }
                    }
                }
            }
        },
        "overlay": {
            "subtle": {
                "hover": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                },
                "active": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                }
            },
            "strong": {
                "hover": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                },
                "active": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                },
                "disabled-active": { "$value": "{primary.overlay.strong.active}" }
            },
            "selected": {
                "$value": "{primary.background.solid.rest}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
            }
        }
    },
