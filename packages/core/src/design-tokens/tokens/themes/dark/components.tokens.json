{
    "breadcrumb": {
        "collapsed-background-color": {
            "$type": "color",
            "$value": "rgba(143, 153, 168, 0.2)"
        }
    },
    "html-table": {
        "border-color": {
            "$type": "color",
            "$value": "rgba(255, 255, 255, 0.2)"
        },
        "striped-background-color": {
            "$type": "color",
            "$value": "rgba(95, 107, 124, 0.15)"
        },
        "background-color-hover": {
            "$type": "color",
            "$value": "rgba(95, 107, 124, 0.3)"
        },
        "background-color-active": {
            "$type": "color",
            "$value": "rgba(95, 107, 124, 0.4)"
        }
    },
    "navbar": {
        "background-color": {
            "$type": "color",
            "$value": "{card.background-color}"
        },
        "self-dark-box-shadow": {
            "$type": "shadow",
            "$value": "inset {elevation.shadow.1}"
        }
    },
    "section": {
        "interactive-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.4}"
        }
    },
    "segmented-control": {
        "background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.2}"
        },
        "button-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.5}"
        }
    },
    "card-list": {
        "container-padding": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
        "unbordered-margin": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
        "unbordered-width": { "$type": "string", "$value": "calc(100% - 2px)" },
        "interactive-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.3}"
        },
        "selected-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.4}"
        }
    },
    "icon": {
        "muted-fill-opacity": { "$type": "number", "$value": 0.2 }
    },
    "dialog": {
        "background-color": { "$type": "color", "$value": "{app-background-color}" },
        "box-shadow": { "$type": "shadow", "$value": "{elevation.shadow.3}" },
        "header-background-color": { "$type": "color", "$value": "{palette.dark-gray.3}" },
        "header-box-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(255, 255, 255, 0.2)"
        },
        "footer-background-color": { "$type": "color", "$value": "{palette.dark-gray.4}" },
        "multistep-nav-divider-color": { "$type": "color", "$value": "{divider-black-strong}" },
        "multistep-left-panel-background-color": { "$type": "color", "$value": "{palette.dark-gray.2}" },
        "multistep-left-panel-border-bottom": {
            "$type": "string",
            "$value": "1px solid rgba(255, 255, 255, 0.2)"
        },
        "multistep-left-panel-border-left": {
            "$type": "string",
            "$value": "1px solid rgba(255, 255, 255, 0.2)"
        },
        "multistep-left-panel-border-radius": { "$type": "dimension", "$value": "{border-radius}" },
        "multistep-right-panel-background-color": { "$type": "color", "$value": "{palette.dark-gray.3}" },
        "multistep-right-panel-border-bottom": {
            "$type": "string",
            "$value": "1px solid rgba(255, 255, 255, 0.2)"
        },
        "multistep-right-panel-border-right": {
            "$type": "string",
            "$value": "1px solid rgba(255, 255, 255, 0.2)"
        },
        "multistep-step-container-background-color": {
            "$type": "color",
            "$value": "{palette.dark-gray.3}"
        },
        "multistep-step-viewed-background-color": { "$type": "color", "$value": "{palette.dark-gray.4}" },
        "multistep-step-background-color": { "$type": "color", "$value": "{palette.dark-gray.3}" },
        "multistep-step-background-color-hover": { "$type": "color", "$value": "{palette.dark-gray.3}" },
        "multistep-step-title-active-color": { "$type": "color", "$value": "{palette.blue.5}" }
    },
    "drawer": {
        "background-color": { "$type": "color", "$value": "{palette.dark-gray.3}" },
        "box-shadow": { "$type": "shadow", "$value": "{elevation.shadow.3}" },
        "divider-color": { "$type": "color", "$value": "{divider-black-strong}" }
    },
    "popover": {
        "background-color": { "$type": "color", "$value": "{palette.dark-gray.3}" },
        "box-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 1px hsl(215, 3%, 38%), {elevation.shadow.3}"
        },
        "arrow-box-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 1px hsl(215, 3%, 48%), 1px 1px 6px rgba(17, 20, 24, 0.4)"
        },
        "arrow-border-fill-opacity": { "$type": "number", "$value": 0.2 }
    },
    "tooltip": {
        "background-color": { "$type": "color", "$value": "{palette.light-gray.3}" },
        "text-color": { "$type": "color", "$value": "{palette.dark-gray.5}" },
        "text-color-muted": { "$type": "color", "$value": "{palette.gray.1}" },
        "text-color-disabled": { "$type": "color", "$value": "rgba(95, 107, 124, 0.6)" },
        "link-color": { "$type": "color", "$value": "{palette.blue.2}" },
        "divider-color": { "$type": "color", "$value": "{divider-black}" },
        "code-text-color": { "$type": "color", "$value": "{palette.gray.1}" },
        "code-background-color": { "$type": "color", "$value": "rgba(255, 255, 255, 0.7)" },
        "code-box-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(17, 20, 24, 0.2)"
        },
        "code-link-color": { "$type": "color", "$value": "{intent.primary.rest}" },
        "key-background-color": { "$type": "color", "$value": "{palette.white}" },
        "key-box-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 1px rgba(17, 20, 24, 0.1), 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)"
        },
        "intent-primary-text-color": { "$type": "color", "$value": "{palette.blue.2}" },
        "intent-success-text-color": { "$type": "color", "$value": "{palette.green.2}" },
        "intent-warning-text-color": { "$type": "color", "$value": "{palette.orange.2}" },
        "intent-danger-text-color": { "$type": "color", "$value": "{palette.red.2}" },
        "box-shadow": {
            "$type": "shadow",
            "$value": "0 2px 4px rgba(17, 20, 24, 0.4), 0 8px 24px rgba(17, 20, 24, 0.4)"
        },
        "arrow-box-shadow": {
            "$type": "shadow",
            "$value": "1px 1px 6px rgba(17, 20, 24, 0.4)"
        },
        "arrow-border-fill-opacity": { "$type": "number", "$value": 0.2 }
    },
    "editable-text": {
        "box-shadow-hover": {
            "$type": "shadow",
            "$value": "0 0 0 0 rgba(138, 187, 255, 0), 0 0 0 0 rgba(138, 187, 255, 0), inset 0 0 0 1px rgba(255, 255, 255, 0.2)"
        },
        "box-shadow-editing": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(138, 187, 255, 0.752), 0 0 0 1px rgba(138, 187, 255, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
        },
        "intent": {
            "primary": {
                "color": { "$type": "color", "$value": "{palette.blue.5}" },
                "box-shadow-hover": {
                    "$type": "shadow",
                    "$value": "0 0 0 0 rgba(138, 187, 255, 0), 0 0 0 0 rgba(138, 187, 255, 0), inset 0 0 0 1px rgba(138, 187, 255, 0.4)"
                },
                "box-shadow-editing": {
                    "$type": "shadow",
                    "$value": "inset 0 0 0 1px rgba(138, 187, 255, 0.752), 0 0 0 1px rgba(138, 187, 255, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                }
            },
            "success": {
                "color": { "$type": "color", "$value": "{palette.green.5}" },
                "box-shadow-hover": {
                    "$type": "shadow",
                    "$value": "0 0 0 0 rgba(114, 202, 155, 0), 0 0 0 0 rgba(114, 202, 155, 0), inset 0 0 0 1px rgba(114, 202, 155, 0.4)"
                },
                "box-shadow-editing": {
                    "$type": "shadow",
                    "$value": "inset 0 0 0 1px rgba(114, 202, 155, 0.752), 0 0 0 1px rgba(114, 202, 155, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                }
            },
            "warning": {
                "color": { "$type": "color", "$value": "{palette.orange.5}" },
                "box-shadow-hover": {
                    "$type": "shadow",
                    "$value": "0 0 0 0 rgba(251, 179, 96, 0), 0 0 0 0 rgba(251, 179, 96, 0), inset 0 0 0 1px rgba(251, 179, 96, 0.4)"
                },
                "box-shadow-editing": {
                    "$type": "shadow",
                    "$value": "inset 0 0 0 1px rgba(251, 179, 96, 0.752), 0 0 0 1px rgba(251, 179, 96, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                }
            },
            "danger": {
                "color": { "$type": "color", "$value": "{palette.red.5}" },
                "box-shadow-hover": {
                    "$type": "shadow",
                    "$value": "0 0 0 0 rgba(250, 153, 156, 0), 0 0 0 0 rgba(250, 153, 156, 0), inset 0 0 0 1px rgba(250, 153, 156, 0.4)"
                },
                "box-shadow-editing": {
                    "$type": "shadow",
                    "$value": "inset 0 0 0 1px rgba(250, 153, 156, 0.752), 0 0 0 1px rgba(250, 153, 156, 0.752), inset 0 0 0 1px rgba(255, 255, 255, 0.2), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.3)"
                }
            }
        }
    },
    "menu": {
        "background-color": { "$type": "color", "$value": "{palette.dark-gray.3}" },
        "intent": {
            "primary": {
                "text-color": { "$type": "color", "$value": "{palette.blue.5}" },
                "text-color-active": { "$type": "color", "$value": "{palette.blue.6}" },
                "background-color-hover": { "$type": "color", "$value": "rgba(45, 114, 210, 0.2)" },
                "background-color-active": { "$type": "color", "$value": "rgba(45, 114, 210, 0.3)" }
            },
            "success": {
                "text-color": { "$type": "color", "$value": "{palette.green.5}" },
                "text-color-active": { "$type": "color", "$value": "{palette.green.6}" },
                "background-color-hover": { "$type": "color", "$value": "rgba(35, 133, 81, 0.2)" },
                "background-color-active": { "$type": "color", "$value": "rgba(35, 133, 81, 0.3)" }
            },
            "warning": {
                "text-color": { "$type": "color", "$value": "{palette.orange.5}" },
                "text-color-active": { "$type": "color", "$value": "{palette.orange.6}" },
                "background-color-hover": { "$type": "color", "$value": "rgba(200, 118, 25, 0.2)" },
                "background-color-active": { "$type": "color", "$value": "rgba(200, 118, 25, 0.3)" }
            },
            "danger": {
                "text-color": { "$type": "color", "$value": "{palette.red.5}" },
                "text-color-active": { "$type": "color", "$value": "{palette.red.6}" },
                "background-color-hover": { "$type": "color", "$value": "rgba(205, 66, 70, 0.2)" },
                "background-color-active": { "$type": "color", "$value": "rgba(205, 66, 70, 0.3)" }
            }
        }
    },
    "callout": {
        "background-color": { "$type": "color", "$value": "rgba(143, 153, 168, 0.2)" },
        "intent": {
            "primary": {
                "background-color": { "$type": "color", "$value": "rgba(45, 114, 210, 0.2)" }
            },
            "success": {
                "background-color": { "$type": "color", "$value": "rgba(35, 133, 81, 0.2)" }
            },
            "warning": {
                "background-color": { "$type": "color", "$value": "rgba(200, 118, 25, 0.2)" }
            },
            "danger": {
                "background-color": { "$type": "color", "$value": "rgba(205, 66, 70, 0.2)" }
            }
        },
        "primary-link-color-hover": { "$type": "color", "$value": "{palette.blue.6}" }
    },
    "toast": {
        "background-color": { "$type": "color", "$value": "{palette.dark-gray.4}" },
        "box-shadow": { "$type": "shadow", "$value": "{elevation.shadow.3}" },
        "button-icon-color": { "$type": "color", "$value": "rgba(255, 255, 255, 0.7)" }
    },
    "slider": {
        "track-background-color": { "$type": "color", "$value": "rgba(17, 20, 24, 0.5)" },
        "handle-background-color": { "$type": "color", "$value": "{palette.gray.4}" },
        "handle-background-color-hover": { "$type": "color", "$value": "{palette.gray.3}" },
        "handle-background-color-active": { "$type": "color", "$value": "{palette.gray.2}" },
        "handle-background-color-disabled": { "$type": "color", "$value": "{palette.gray.1}" },
        "handle-border-color-disabled": { "$type": "color", "$value": "{palette.gray.1}" },
        "handle-box-shadow": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(255, 255, 255, 0.1), 0 1px 2px rgba(17, 20, 24, 0.2)"
        },
        "handle-box-shadow-hover": {
            "$type": "shadow",
            "$value": "inset 0 0 0 1px rgba(255, 255, 255, 0.1), 0 1px 2px rgba(17, 20, 24, 0.4)"
        },
        "handle-box-shadow-active": {
            "$type": "shadow",
            "$value": "inset 0 1px 1px rgba(17, 20, 24, 0.1), inset 0 0 0 1px rgba(255, 255, 255, 0.1), 0 1px 2px rgba(17, 20, 24, 0.4)"
        }
    },
    "tree": {
        "background-color-hover": { "$type": "color", "$value": "rgba(95, 107, 124, 0.3)" },
        "intent": {
            "primary": { "icon-color": { "$type": "color", "$value": "{palette.blue.5}" } },
            "success": { "icon-color": { "$type": "color", "$value": "{palette.green.5}" } },
            "warning": { "icon-color": { "$type": "color", "$value": "{palette.orange.5}" } },
            "danger": { "icon-color": { "$type": "color", "$value": "{palette.red.5}" } }
        }
    },
    "progress-bar": {
        "track-color": {
            "$type": "color",
            "$value": "rgba(17, 20, 24, 0.5)"
        },
        "head-color": {
            "$type": "color",
            "$value": "{palette.gray.3}"
        }
    }
}
