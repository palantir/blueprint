{
    "button": {
        "background": {
            "$type": "color",
            "default": {
                "rest": { "$value": "#2f343c" },
                "hover": { "$value": "#252a31" },
                "active": { "$value": "#1c2127" },
                "disabled": {
                    "$value": { "colorSpace": "srgb", "components": [0.1843, 0.2039, 0.2353], "alpha": 0.15 }
                },
                "active-disabled": {
                    "$value": { "colorSpace": "srgb", "components": [0.1843, 0.2039, 0.2353], "alpha": 0.7 }
                }
            }
        },
        "icon": {
            "foreground": {
                "$type": "color",
                "default": {
                    "rest": { "$value": "{typography.color-default.rest}" }
                }
            }
        },
        "foreground": {
            "$type": "color",
            "default": {
                "rest": { "$value": "{typography.color-default.rest}" },
                "disabled": {
                    "$value": { "colorSpace": "srgb", "components": [0.6706, 0.702, 0.749], "alpha": 0.6 }
                }
            },
            "intent": {
                "primary": {
                    "disabled": {
                        "$value": "{intent.primary.foreground}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                    }
                },
                "success": {
                    "disabled": {
                        "$value": "{intent.success.foreground}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                    }
                },
                "warning": {
                    "disabled": {
                        "$value": {
                            "colorSpace": "oklch",
                            "components": [0.189828, 0.00940823, "none"],
                            "alpha": 0.5
                        }
                    }
                },
                "danger": {
                    "disabled": {
                        "$value": "{intent.danger.foreground}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                    }
                }
            },
            "minimal": {
                "intent": {
                    "default": {
                        "rest": { "$value": "{intent.default.foreground}" },
                        "hover": { "$value": "{intent.default.foreground}" },
                        "active": { "$value": "{intent.default.foreground}" }
                    },
                    "primary": {
                        "rest": { "$value": "{intent.primary.disabled}" },
                        "hover": { "$value": "{intent.primary.disabled}" },
                        "active": { "$value": "{intent.primary.disabled}" }
                    },
                    "success": {
                        "rest": { "$value": "{intent.success.disabled}" },
                        "hover": { "$value": "{intent.success.disabled}" },
                        "active": { "$value": "{intent.success.disabled}" }
                    },
                    "warning": {
                        "rest": { "$value": "{intent.warning.disabled}" },
                        "hover": { "$value": "{intent.warning.disabled}" },
                        "active": { "$value": "{intent.warning.disabled}" }
                    },
                    "danger": {
                        "rest": { "$value": "{intent.danger.disabled}" },
                        "hover": { "$value": "{intent.danger.disabled}" },
                        "active": { "$value": "{intent.danger.disabled}" }
                    }
                }
            }
        },
        "shadow": {
            "$type": "shadow",
            "rest": {
                "$value": [
                    {
                        "inset": true,
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 0, "unit": "px" },
                        "blur": { "value": 0, "unit": "px" },
                        "spread": { "value": 1, "unit": "px" },
                        "color": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.1 }
                    },
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 1, "unit": "px" },
                        "blur": { "value": 2, "unit": "px" },
                        "color": { "colorSpace": "srgb", "components": [0.0667, 0.0784, 0.0941], "alpha": 0.2 }
                    }
                ]
            },
            "active": {
                "$value": [
                    {
                        "inset": true,
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 0, "unit": "px" },
                        "blur": { "value": 0, "unit": "px" },
                        "spread": { "value": 1, "unit": "px" },
                        "color": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.1 }
                    },
                    {
                        "offsetX": { "value": 0, "unit": "px" },
                        "offsetY": { "value": 1, "unit": "px" },
                        "blur": { "value": 2, "unit": "px" },
                        "color": { "colorSpace": "srgb", "components": [0.0667, 0.0784, 0.0941], "alpha": 0.4 }
                    }
                ]
            }
        },
        "spinner": {
            "$type": "color",
            "track": { "$value": "{surface.background-color.default.active}" },
            "head": { "$value": "{typography.color-default.rest}" }
        }
    }
}
