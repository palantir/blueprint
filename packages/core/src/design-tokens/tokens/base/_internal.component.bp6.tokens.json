{
    "_internal": {
        "$description": "Private component aliases. These are implementation details, not public theming API.",
        "component": {
            "button": {
                "background": {
                    "$type": "color",
                    "default": {
                        "disabled": {
                            "$value": {
                                "colorSpace": "srgb",
                                "components": [0.8275, 0.8471, 0.8706],
                                "alpha": 0.5
                            }
                        },
                        "active-disabled": {
                            "$value": {
                                "colorSpace": "srgb",
                                "components": [0.8275, 0.8471, 0.8706],
                                "alpha": 0.7
                            }
                        }
                    },
                    "intent": {
                        "primary": {
                            "disabled": {
                                "$value": "{intent.primary.rest}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                            }
                        },
                        "success": {
                            "disabled": {
                                "$value": "#23855180"
                            }
                        },
                        "warning": {
                            "disabled": {
                                "$value": "{intent.warning.rest}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.4 } }
                            }
                        },
                        "danger": {
                            "disabled": {
                                "$value": "#cd424680"
                            }
                        }
                    }
                },
                "foreground": {
                    "$type": "color",
                    "default": {
                        "disabled": {
                            "$value": { "colorSpace": "srgb", "components": [0.3725, 0.4196, 0.4863], "alpha": 0.6 }
                        }
                    },
                    "intent": {
                        "primary": {
                            "disabled": {
                                "$value": "{intent.primary.foreground}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                            }
                        },
                        "success": {
                            "disabled": {
                                "$value": "{intent.success.foreground}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                            }
                        },
                        "warning": {
                            "disabled": {
                                "$value": {
                                    "colorSpace": "oklch",
                                    "components": [0.189828, 0.00940823, "none"],
                                    "alpha": 0.6
                                }
                            }
                        },
                        "danger": {
                            "disabled": {
                                "$value": "{intent.danger.foreground}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                            }
                        }
                    }
                },
                "shadow": {
                    "$type": "shadow",
                    "rest": {
                        "$value": [
                            {
                                "inset": true,
                                "offsetX": { "value": 0, "unit": "px" },
                                "offsetY": { "value": 0, "unit": "px" },
                                "blur": { "value": 0, "unit": "px" },
                                "spread": { "value": 1, "unit": "px" },
                                "color": { "colorSpace": "srgb", "components": [0.0667, 0.0784, 0.0941], "alpha": 0.2 }
                            },
                            {
                                "offsetX": { "value": 0, "unit": "px" },
                                "offsetY": { "value": 1, "unit": "px" },
                                "blur": { "value": 2, "unit": "px" },
                                "color": { "colorSpace": "srgb", "components": [0.0667, 0.0784, 0.0941], "alpha": 0.1 }
                            }
                        ]
                    },
                    "active": {
                        "$value": [
                            {
                                "inset": true,
                                "offsetX": { "value": 0, "unit": "px" },
                                "offsetY": { "value": 0, "unit": "px" },
                                "blur": { "value": 0, "unit": "px" },
                                "spread": { "value": 1, "unit": "px" },
                                "color": { "colorSpace": "srgb", "components": [0.0667, 0.0784, 0.0941], "alpha": 0.2 }
                            },
                            {
                                "offsetX": { "value": 0, "unit": "px" },
                                "offsetY": { "value": 1, "unit": "px" },
                                "blur": { "value": 2, "unit": "px" },
                                "color": { "colorSpace": "srgb", "components": [0.0667, 0.0784, 0.0941], "alpha": 0.2 }
                            }
                        ]
                    }
                }
            }
        }
    }
}
