                "leading-icon-color": { "$type": "color", "$value": "rgba(255, 255, 255, 0.7)" },
                "button-background-color-hover": { "$type": "color", "$value": "{palette.red.2}" },
                "button-background-color-active": { "$type": "color", "$value": "{palette.red.1}" },
                "focus-outline-color": { "$type": "color", "$value": "rgba(255, 255, 255, 0.75)" }
            }
        }
    },
    "slider": {
        "handle-size": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "track-size": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
        "label-offset": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "min-size": { "$type": "dimension", "$value": { "value": 150, "unit": "px" } },
        "size": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
        "track-background-color": { "$type": "color", "$value": "rgba(95, 107, 124, 0.2)" },
        "handle-background-color": { "$type": "color", "$value": "{button.background-color}" },
        "handle-background-color-hover": { "$type": "color", "$value": "{button.background-color-hover}" },
        "handle-background-color-active": { "$type": "color", "$value": "{button.background-color-active}" },
        "handle-background-color-disabled": { "$type": "color", "$value": "{palette.gray.5}" },
        "handle-border-color-disabled": { "$type": "color", "$value": "currentcolor" },
        "handle-box-shadow": {
            "$type": "shadow",
            "$value": "0 0 0 1px rgba(17, 20, 24, 0.5), 0 1px 1px rgba(17, 20, 24, 0.5)"
        },
        "handle-box-shadow-hover": {
            "$type": "shadow",
            "$value": "0 0 0 1px rgba(17, 20, 24, 0.5), 0 1px 2px rgba(17, 20, 24, 0.6)"
        },
        "handle-box-shadow-active": {
            "$type": "shadow",
            "$value": "inset 0 1px 1px rgba(17, 20, 24, 0.1), 0 0 0 1px rgba(17, 20, 24, 0.5), 0 1px 2px rgba(17, 20, 24, 0.2)"
        }
    },
    "tree": {
        "row-height": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
        "icon-spacing": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
        "row-height-compact": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "icon-spacing-compact": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
        "background-color-hover": { "$type": "color", "$value": "rgba(143, 153, 168, 0.15)" },
        "background-color-active": { "$type": "color", "$value": "rgba(143, 153, 168, 0.3)" },
        "caret-transition-duration": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
        "selected-background-color": { "$type": "color", "$value": "{intent.primary.rest}" },
        "selected-text-color": { "$type": "color", "$value": "{palette.white}" },
        "selected-caret-color": { "$type": "color", "$value": "rgba(255, 255, 255, 0.7)" },
        "selected-caret-color-hover": { "$type": "color", "$value": "{palette.white}" },
        "intent": {
            "primary": { "icon-color": { "$type": "color", "$value": "{intent.primary.rest}" } },
            "success": { "icon-color": { "$type": "color", "$value": "{intent.success.rest}" } },
            "warning": { "icon-color": { "$type": "color", "$value": "{intent.warning.rest}" } },
            "danger": { "icon-color": { "$type": "color", "$value": "{intent.danger.rest}" } }
        }
    },
    "progress-bar": {
        "track-color": {
            "$type": "color",
            "$value": "rgba(95, 107, 124, 0.2)"
        },
        "head-color": {
            "$type": "color",
            "$value": "rgba(95, 107, 124, 0.8)"
        },
        "stripes-color": {
            "$type": "color",
            "$value": "rgba(255, 255, 255, 0.2)"
        },
        "height": {
            "$type": "dimension",
            "$value": { "value": 8, "unit": "px" }
        },
        "stripes-size": {
            "$type": "dimension",
            "$value": { "value": 30, "unit": "px" }
        },
        "border-radius": {
            "$type": "dimension",
            "$value": { "value": 40, "unit": "px" }
        },
        "transition-duration": {
            "$type": "duration",
            "$value": { "value": 200, "unit": "ms" }
        },
        "animation-duration": {
            "$type": "duration",
            "$value": { "value": 300, "unit": "ms" }
        }
    },
    "spinner": {
        "transition-duration": {
            "$type": "duration",
            "$value": { "value": 200, "unit": "ms" }
        },
        "animation-duration": {
            "$type": "duration",
            "$value": { "value": 500, "unit": "ms" }
        }
    }
}
