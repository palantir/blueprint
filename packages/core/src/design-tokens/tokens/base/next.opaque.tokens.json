{
    "neutral": {
        "$type": "color",
        "palette": {
            "0": {
                "$value": "color-mix(in oklch, {neutral.base} 5%, {palette.white})"
            },
            "1": {
                "$value": "color-mix(in oklch, {neutral.base} 10%, {palette.white})"
            },
            "2": {
                "$value": "color-mix(in oklch, {neutral.base} 20%, {palette.white})"
            },
            "3": {
                "$value": "color-mix(in oklch, {neutral.base} 35%, {palette.white})"
            },
            "4": {
                "$value": "color-mix(in oklch, {neutral.base} 60%, {palette.white})"
            },
            "5": {
                "$value": "{neutral.base}"
            },
            "6": {
                "$value": "color-mix(in oklch, {neutral.base} 90%, {palette.black})"
            },
            "7": {
                "$value": "color-mix(in oklch, {neutral.base} 80%, {palette.black})"
            },
            "8": {
                "$value": "color-mix(in oklch, {neutral.base} 70%, {palette.black})"
            },
            "9": {
                "$value": "color-mix(in oklch, {neutral.base} 60%, {palette.black})"
            }
        },
        "background": {
            "solid": {
                "rest": {
                    "$value": "{neutral.palette.5}"
                },
                "hover": {
                    "$value": "{neutral.palette.6}"
                },
                "active": {
                    "$value": "{neutral.palette.7}"
                }
            },
            "subtle": {
                "rest": {
                    "$value": "{neutral.palette.1}"
                },
                "hover": {
                    "$value": "{neutral.palette.2}"
                },
                "active": {
                    "$value": "{neutral.palette.3}"
                }
            }
        },
        "border": {
            "strong": {
                "rest": {
                    "$value": "{neutral.palette.5}"
                }
            }
        },
        "text": {
            "normal": {
                "$value": "{neutral.palette.8}"
            },
            "strong": {
                "$value": "{neutral.palette.9}"
            },
            "on-solid": {
                "$value": "contrast-color({neutral.background.solid.rest})"
            },
            "muted": {
                "$value": "{neutral.palette.7}"
            },
            "soft": {
                "$value": "{neutral.text.normal}"
            }
        }
