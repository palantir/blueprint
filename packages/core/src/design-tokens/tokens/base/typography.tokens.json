{
    "typography": {
        "family": {
            "$type": "fontFamily",
            "default": {
                "$value": [
                    "-apple-system",
                    "BlinkMacSystemFont",
                    "Segoe UI",
                    "Roboto",
                    "Oxygen",
                    "Ubuntu",
                    "Cantarell",
                    "Open Sans",
                    "Helvetica Neue",
                    "blueprint-icons-16",
                    "sans-serif"
                ]
            },
            "mono": {
                "$value": ["monospace"]
            }
        },
        "size": {
            "$type": "dimension",
            "body-x-small": {
                "$value": {
                    "value": 10,
                    "unit": "px"
                }
            },
            "body-small": {
                "$value": {
                    "value": 12,
                    "unit": "px"
                }
            },
            "body-medium": {
                "$value": {
                    "value": 14,
                    "unit": "px"
                }
            },
            "body-large": {
                "$value": {
                    "value": 16,
                    "unit": "px"
                }
            },
            "heading-small": {
                "$value": {
                    "value": 16,
                    "unit": "px"
                }
            },
            "heading-medium": {
                "$value": {
                    "value": 20,
                    "unit": "px"
                }
            },
            "heading-large": {
                "$value": {
                    "value": 24,
                    "unit": "px"
                }
            },
            "heading-x-large": {
                "$value": {
                    "value": 28,
                    "unit": "px"
                }
            },
            "heading-display": {
                "$value": {
                    "value": 46,
                    "unit": "px"
                }
            },
            "code-small": {
                "$value": {
                    "value": 12,
                    "unit": "px"
                }
            },
            "code-medium": {
                "$value": {
                    "value": 13,
                    "unit": "px"
                }
            },
            "code-large": {
                "$value": {
                    "value": 14,
                    "unit": "px"
                }
            }
        },
        "weight": {
            "$type": "fontWeight",
            "default": {
                "$value": 400
            },
            "bold": {
                "$value": 600
            }
        },
        "line-height": {
            "$type": "number",
            "default": {
                "$value": 1.28581
            },
            "large": {
                "$value": 1.5
            }
        },
        "color-muted": {
            "$type": "color",
            "$value": "{palette.gray.1}"
        },
        "color-default": {
            "$type": "color",
            "rest": {
                "$value": "{palette.dark-gray.1}"
            },
            "hover": {
                "$value": "{palette.black}"
            },
            "active": {
                "$value": "{palette.dark-gray.2}"
            },
            "disabled": {
                "$value": "{palette.gray.1}",
                "$extensions": {
                    "com.blueprint.derive": { "alpha": 0.6 }
                }
            }
        },
        "color-primary": {
            "$type": "color",
            "rest": {
                "$value": "{palette.blue.2}"
            },
            "hover": {
                "$value": "{palette.blue.2}"
            },
            "active": {
                "$value": "{palette.blue.1}"
            },
            "disabled": {
                "$value": "{palette.blue.4}"
            }
        },
        "color-success": {
            "$type": "color",
            "rest": {
                "$value": "{palette.green.2}"
            },
            "hover": {
                "$value": "{palette.green.2}"
            },
            "active": {
                "$value": "{palette.green.1}"
            },
            "disabled": {
                "$value": "{palette.green.4}"
            }
        },
        "color-warning": {
            "$type": "color",
            "rest": {
                "$value": "{palette.orange.2}"
            },
            "hover": {
                "$value": "{palette.orange.2}"
            },
            "active": {
                "$value": "{palette.orange.1}"
            },
            "disabled": {
                "$value": "{palette.orange.4}"
            }
        },
        "color-danger": {
            "$type": "color",
            "rest": {
                "$value": "{palette.red.2}"
            },
            "hover": {
                "$value": "{palette.red.2}"
            },
            "active": {
                "$value": "{palette.red.1}"
            },
            "disabled": {
                "$value": "{palette.red.4}"
            }
        }
    }
}
