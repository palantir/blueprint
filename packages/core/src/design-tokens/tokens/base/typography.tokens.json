{
    "typography": {
        "family": {
            "$type": "fontFamily",
            "default": {
                "$value": [
                    "-apple-system",
                    "BlinkMacSystemFont",
                    "Segoe UI",
                    "Roboto",
                    "Oxygen",
                    "Ubuntu",
                    "Cantarell",
                    "Open Sans",
                    "Helvetica Neue",
                    "blueprint-icons-16",
                    "sans-serif"
                ]
            },
            "mono": {
                "$value": ["monospace"]
            }
        },
        "size": {
            "$type": "dimension",
            "body-x-small": {
                "$value": {
                    "value": 10,
                    "unit": "px"
                }
            },
            "body-small": {
                "$value": {
                    "value": 12,
                    "unit": "px"
                }
            },
            "body-medium": {
                "$value": {
                    "value": 14,
                    "unit": "px"
                }
            },
            "body-large": {
                "$value": {
                    "value": 16,
                    "unit": "px"
                }
            },
            "heading-small": {
                "$value": {
                    "value": 16,
                    "unit": "px"
                }
            },
            "heading-medium": {
                "$value": {
                    "value": 20,
                    "unit": "px"
                }
            },
            "heading-large": {
                "$value": {
                    "value": 24,
                    "unit": "px"
                }
            },
            "heading-x-large": {
                "$value": {
                    "value": 28,
                    "unit": "px"
                }
            },
            "heading-display": {
                "$value": {
                    "value": 46,
                    "unit": "px"
                }
            },
            "code-small": {
                "$value": {
                    "value": 12,
                    "unit": "px"
                }
            },
            "code-medium": {
                "$value": {
                    "value": 13,
                    "unit": "px"
                }
            },
            "code-large": {
                "$value": {
                    "value": 14,
                    "unit": "px"
                }
            }
        },
        "weight": {
            "$type": "fontWeight",
            "default": {
                "$value": 400
            },
            "bold": {
                "$value": 600
            }
        },
        "line-height": {
            "$type": "number",
            "default": {
                "$value": 1.28581
            },
            "large": {
                "$value": 1.5
            }
        },
        "color-muted": {
            "$type": "color",
            "$value": "{intent.default.text-muted}"
        },
        "color-default": {
            "$type": "color",
            "rest": {
                "$value": "{intent.default.text}"
            },
            "hover": {
                "$value": "{intent.default.text-hover}"
            },
            "active": {
                "$value": "{intent.default.text-active}"
            },
            "disabled": {
                "$value": "{intent.default.text-disabled}"
            }
        },
        "color-primary": {
            "$type": "color",
            "rest": {
                "$value": "{intent.primary.text}"
            },
            "hover": {
                "$value": "{intent.primary.text}"
            },
            "active": {
                "$value": "{intent.primary.text-active}"
            },
            "disabled": {
                "$value": "{intent.primary.disabled}"
            }
        },
        "color-success": {
            "$type": "color",
            "rest": {
                "$value": "{intent.success.text}"
            },
            "hover": {
                "$value": "{intent.success.text}"
            },
            "active": {
                "$value": "{intent.success.text-active}"
            },
            "disabled": {
                "$value": "{intent.success.disabled}"
            }
        },
        "color-warning": {
            "$type": "color",
            "rest": {
                "$value": "{intent.warning.text}"
            },
            "hover": {
                "$value": "{intent.warning.text}"
            },
            "active": {
                "$value": "{intent.warning.text-active}"
            },
            "disabled": {
                "$value": "{intent.warning.disabled}"
            }
        },
        "color-danger": {
            "$type": "color",
            "rest": {
                "$value": "{intent.danger.text}"
            },
            "hover": {
                "$value": "{intent.danger.text}"
            },
            "active": {
                "$value": "{intent.danger.text-active}"
            },
            "disabled": {
                "$value": "{intent.danger.disabled}"
            }
        }
    }
}
