{
    "primary": {
        "$type": "color",
        "border": {
            "alpha": {
                "rest": {
                    "$value": "{primary.text.normal}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                }
            }
        },
        "alpha": {
            "source": {
                "$value": "{palette.blue.3}"
            }
        },
        "background": {
            "alpha": {
                "subtle": {
                    "rest": {
                        "$value": "{primary.alpha.source}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.1 } }
                    },
                    "hover": {
                        "$value": "{primary.alpha.source}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                    },
                    "active": {
                        "$value": "{primary.alpha.source}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                    }
                }
            }
        },
        "overlay": {
            "subtle": {
                "hover": {
                    "$value": "{primary.alpha.source}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.1 } }
                },
                "active": {
                    "$value": "{primary.alpha.source}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                }
            },
            "strong": {
                "hover": {
                    "$value": "{primary.alpha.source}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.15 } }
                },
                "active": {
                    "$value": "{primary.alpha.source}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                }
            }
        }
    },
    "opacity": {
        "$type": "number",
        "disabled": {
            "$value": 0.5,
            "$description": "Opacity multiplier for disabled states"
        }
    },
