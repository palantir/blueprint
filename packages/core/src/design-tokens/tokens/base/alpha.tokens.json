                    "$value": "{primary.accent}",
                    "$extensions": { "com.blueprint.derive": { "alpha": "{opacity.disabled}" } }
                }
            },
            "alpha": {
                "subtle": {
                    "rest": {
                        "$value": "{primary.accent}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.1 } }
                    },
                    "hover": {
