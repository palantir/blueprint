{
    "primary": {
        "$type": "color",
        "text": {
            "on-solid-disabled": {
                "$value": "{primary.text.on-solid}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
            },
            "disabled": {
                "$value": "{primary.text.normal}",
                "$extensions": { "com.blueprint.derive": { "alpha": "{opacity.disabled}" } }
            }
        },
        "border": {
            "alpha": {
                "rest": {
                    "$value": "{primary.text.normal}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                },
                "disabled": {
                    "$value": "{primary.text.normal}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                }
            }
        },
        "background": {
            "solid": {
                "disabled": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": "{opacity.disabled}" } }
                }
            },
            "alpha": {
                "rest": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.1 } }
                },
                "hover": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                },
                "active": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                }
            }
        },
        "layer": {
            "subtle": {
                "hover": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.1 } }
                },
                "active": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
                }
            },
            "strong": {
                "hover": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.15 } }
                },
                "active": {
                    "$value": "{primary.base}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.3 } }
                },
                "disabled-active": { "$value": "{primary.layer.strong.active}" }
            },
            "selected": {
                "$value": "{primary.background.solid.rest}",
                "$extensions": { "com.blueprint.derive": { "alpha": 0.2 } }
            }
        }
    },
    "opacity": {
        "$type": "number",
        "disabled": {
            "$value": 0.5,
            "$description": "Opacity multiplier for disabled states"
        }
    },
