{
    "intent": {
        "$type": "color",
        "$description": "Semantic intent color roles and legacy interaction-state tokens.",
        "neutral": {
            "background": {
                "subtle": { "$value": "{color.grey.2}" },
                "rest": { "$value": "{color.grey.3}" },
                "hover": { "$value": "{color.grey.4}" },
                "active": { "$value": "{color.grey.5}" },
                "disabled-active": { "$value": "color-mix(in srgb, {intent.default.disabled} 30%, transparent)" }
            },
            "border": {
                "subtle": { "$value": "{color.grey.6}" },
                "rest": { "$value": "{color.grey.7}" },
                "hover": { "$value": "{color.grey.8}" },
                "disabled": { "$value": "{surface.border-color.default}" }
            },
            "solid": {
                "rest": { "$value": "{color.grey.9}" },
                "hover": { "$value": "{color.grey.10}" },
                "active": { "$value": "{color.grey.11}" },
                "disabled": { "$value": "color-mix(in srgb, {intent.default.disabled} 20%, transparent)" },
                "disabled-active": { "$value": "color-mix(in srgb, {intent.default.disabled} 28%, transparent)" },
                "foreground": { "$value": "{color.grey.contrast}" },
                "foreground-disabled": { "$value": "{typography.color-default.disabled}" }
            }
        },
        "default": {
            "background": {
                "disabled-active": { "$value": "color-mix(in oklch, {intent.default.rest} 30%, transparent)" }
            },
            "border": {
                "disabled": { "$value": "color-mix(in oklch, {intent.default.hover} 20%, transparent)" }
            },
            "solid": {
                "disabled": { "$value": "color-mix(in oklch, {intent.default.rest} 50%, transparent)" },
                "foreground-disabled": { "$value": "color-mix(in oklch, {intent.default.foreground} 60%, transparent)" }
            },
            "rest": { "$value": "{palette.gray.1}" },
            "hover": { "$value": "{palette.dark-gray.5}" },
            "active": { "$value": "{palette.dark-gray.4}" },
            "disabled": { "$value": "{palette.gray.3}" },
            "foreground": { "$value": "{palette.white}" }
        },
        "primary": {
            "background": {
                "subtle": { "$value": "{color.blue.2}" },
                "rest": { "$value": "{color.blue.3}" },
                "hover": { "$value": "{color.blue.4}" },
                "active": { "$value": "{color.blue.5}" },
                "disabled-active": { "$value": "color-mix(in oklch, {intent.primary.rest} 30%, transparent)" }
            },
            "border": {
                "subtle": { "$value": "{color.blue.6}" },
                "rest": { "$value": "{color.blue.7}" },
                "hover": { "$value": "{color.blue.8}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.primary.hover} 20%, transparent)" }
            },
            "solid": {
                "rest": { "$value": "{color.blue.9}" },
                "hover": { "$value": "{color.blue.10}" },
                "active": { "$value": "{color.blue.11}" },
                "foreground": { "$value": "{color.blue.contrast}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.primary.rest} 50%, transparent)" },
                "foreground-disabled": { "$value": "color-mix(in oklch, {intent.primary.foreground} 60%, transparent)" }
            },
            "rest": { "$value": "{palette.blue.3}" },
            "hover": { "$value": "{palette.blue.2}" },
            "active": { "$value": "{palette.blue.1}" },
            "disabled": { "$value": "{palette.blue.4}" },
            "foreground": { "$value": "{palette.white}" }
        },
        "success": {
            "background": {
                "subtle": { "$value": "{color.green.2}" },
                "rest": { "$value": "{color.green.3}" },
                "hover": { "$value": "{color.green.4}" },
                "active": { "$value": "{color.green.5}" },
                "disabled-active": { "$value": "color-mix(in oklch, {intent.success.rest} 30%, transparent)" }
            },
            "border": {
                "subtle": { "$value": "{color.green.6}" },
                "rest": { "$value": "{color.green.7}" },
                "hover": { "$value": "{color.green.8}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.success.hover} 20%, transparent)" }
            },
            "solid": {
                "rest": { "$value": "{color.green.9}" },
                "hover": { "$value": "{color.green.10}" },
                "active": { "$value": "{color.green.11}" },
                "foreground": { "$value": "{color.green.contrast}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.success.rest} 50%, transparent)" },
                "foreground-disabled": { "$value": "color-mix(in oklch, {intent.success.foreground} 60%, transparent)" }
            },
            "rest": { "$value": "{palette.green.3}" },
            "hover": { "$value": "{palette.green.2}" },
            "active": { "$value": "{palette.green.1}" },
            "disabled": { "$value": "{palette.green.4}" },
            "foreground": { "$value": "{palette.white}" }
        },
        "warning": {
            "background": {
                "subtle": { "$value": "{color.orange.2}" },
                "rest": { "$value": "{color.orange.3}" },
                "hover": { "$value": "{color.orange.4}" },
                "active": { "$value": "{color.orange.5}" },
                "disabled-active": {
                    "$value": "{intent.warning.rest}",
                    "$extensions": {
                        "com.blueprint.derive": {
                            "lightnessOffset": 0.177,
                            "chromaOffset": -0.01,
                            "hueOffset": 6.26,
                            "alpha": 0.3
                        }
                    }
                }
            },
            "border": {
                "subtle": { "$value": "{color.orange.6}" },
                "rest": { "$value": "{color.orange.7}" },
                "hover": { "$value": "{color.orange.8}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.warning.hover} 20%, transparent)" }
            },
            "solid": {
                "rest": { "$value": "{color.orange.9}" },
                "hover": { "$value": "{color.orange.10}" },
                "active": { "$value": "{color.orange.11}" },
                "foreground": { "$value": "{color.orange.contrast}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.warning.rest} 40%, transparent)" },
                "foreground-disabled": { "$value": "color-mix(in oklch, {intent.warning.foreground} 60%, transparent)" }
            },
            "rest": { "$value": "{palette.orange.3}" },
            "hover": { "$value": "{palette.orange.2}" },
            "active": { "$value": "{palette.orange.1}" },
            "disabled": { "$value": "{palette.orange.4}" },
            "foreground": { "$value": "{palette.black}" }
        },
        "danger": {
            "background": {
                "subtle": { "$value": "{color.red.2}" },
                "rest": { "$value": "{color.red.3}" },
                "hover": { "$value": "{color.red.4}" },
                "active": { "$value": "{color.red.5}" },
                "disabled-active": { "$value": "color-mix(in oklch, {intent.danger.rest} 30%, transparent)" }
            },
            "border": {
                "subtle": { "$value": "{color.red.6}" },
                "rest": { "$value": "{color.red.7}" },
                "hover": { "$value": "{color.red.8}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.danger.hover} 20%, transparent)" }
            },
            "solid": {
                "rest": { "$value": "{color.red.9}" },
                "hover": { "$value": "{color.red.10}" },
                "active": { "$value": "{color.red.11}" },
                "foreground": { "$value": "{color.red.contrast}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.danger.rest} 50%, transparent)" },
                "foreground-disabled": { "$value": "color-mix(in oklch, {intent.danger.foreground} 60%, transparent)" }
            },
            "rest": { "$value": "{palette.red.3}" },
            "hover": { "$value": "{palette.red.2}" },
            "active": { "$value": "{palette.red.1}" },
            "disabled": { "$value": "{palette.red.4}" },
            "foreground": { "$value": "{palette.white}" }
        }
    }
}
