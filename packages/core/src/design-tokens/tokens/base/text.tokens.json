{
    "text": {
        "color": {
            "$type": "color",
            "$description": "Semantic text colors: default uses palette step 13 and muted uses step 12.",
            "neutral": {
                "default": { "$value": "{color.grey.13}" },
                "muted": { "$value": "{color.grey.12}" },
                "disabled": { "$value": "{typography.color-default.disabled}" }
            },
            "default": {
                "disabled": { "$value": "color-mix(in oklch, {intent.default.hover} 50%, transparent)" }
            },
            "primary": {
                "default": { "$value": "{color.blue.13}" },
                "muted": { "$value": "{color.blue.12}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.primary.hover} 50%, transparent)" }
            },
            "success": {
                "default": { "$value": "{color.green.13}" },
                "muted": { "$value": "{color.green.12}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.success.hover} 50%, transparent)" }
            },
            "warning": {
                "default": { "$value": "{color.orange.13}" },
                "muted": { "$value": "{color.orange.12}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.warning.hover} 40%, transparent)" }
            },
            "danger": {
                "default": { "$value": "{color.red.13}" },
                "muted": { "$value": "{color.red.12}" },
                "disabled": { "$value": "color-mix(in oklch, {intent.danger.hover} 50%, transparent)" }
            }
        }
    }
}
