{
    "menu": {
        "$description": "Public Menu appearance tokens. Defaults reference semantic tokens so global theme changes continue to propagate.",
        "background": {
            "$type": "color",
            "rest": { "$value": "{surface.background-color.default.rest}" }
        },
        "foreground": {
            "$type": "color",
            "rest": { "$value": "{typography.color-default.rest}" },
            "muted": { "$value": "{typography.color-muted}" },
            "disabled": { "$value": "{typography.color-default.disabled}" }
        },
        "border-radius": {
            "$type": "dimension",
            "$value": "{surface.border-radius}"
        },
        "font-family": {
            "$type": "fontFamily",
            "$value": "{typography.family.default}"
        },
        "font-size": {
            "$type": "dimension",
            "$value": "{typography.size.body-medium}"
        },
        "divider-color": {
            "$type": "color",
            "$value": "{surface.border-color.default}"
        },
        "item": {
            "border-radius": {
                "$type": "dimension",
                "$value": "{surface.border-radius}"
            },
            "background": {
                "$type": "color",
                "hover": { "$value": "{surface.layer-color.default}" },
                "active": { "$value": "{surface.layer-color.default}" },
                "intent": {
                    "primary": {
                        "hover": { "$value": "{surface.layer-color.primary}" },
                        "active": { "$value": "{surface.layer-color.primary}" }
                    },
                    "success": {
                        "hover": { "$value": "{surface.layer-color.success}" },
                        "active": { "$value": "{surface.layer-color.success}" }
                    },
                    "warning": {
                        "hover": { "$value": "{surface.layer-color.warning}" },
                        "active": { "$value": "{surface.layer-color.warning}" }
                    },
                    "danger": {
                        "hover": { "$value": "{surface.layer-color.danger}" },
                        "active": { "$value": "{surface.layer-color.danger}" }
                    }
                }
            },
            "foreground": {
                "$type": "color",
                "intent": {
                    "primary": { "$value": "{typography.color-primary.hover}" },
                    "success": { "$value": "{typography.color-success.hover}" },
                    "warning": { "$value": "{typography.color-warning.hover}" },
                    "danger": { "$value": "{typography.color-danger.hover}" }
                }
            }
        }
    }
}
