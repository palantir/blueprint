{
    "typography": {
        "color": {
            "$type": "color",
            "$description": "Dark-mode text. base is near-white body text (BP6 light-gray.5, equivalent of next grey.100); intent text resolves one stop darker (BP6 .2, equivalent of next .600) than the global intent tokens.",
            "base": { "$value": "{palette.light-gray.5}" },
            "intent": {
                "neutral": {
                    "$value": "{intent.neutral}",
                    "$extensions": {
                        "com.blueprint.derive": { "lightnessOffset": 0.277 },
                        "com.blueprint.palette-equivalent": "{palette.gray.1}"
                    }
                },
                "primary": {
                    "$value": "{intent.primary}",
                    "$extensions": {
                        "com.blueprint.derive": { "lightnessOffset": 0.262, "chromaOffset": -0.066 },
                        "com.blueprint.palette-equivalent": "{palette.blue.2}"
                    }
                },
                "success": {
                    "$value": "{intent.success}",
                    "$extensions": {
                        "com.blueprint.derive": { "lightnessOffset": 0.262, "chromaOffset": -0.066 },
                        "com.blueprint.palette-equivalent": "{palette.green.2}"
                    }
                },
                "warning": {
                    "$value": "{intent.warning}",
                    "$extensions": {
                        "com.blueprint.derive": { "lightnessOffset": 0.262, "chromaOffset": -0.066 },
                        "com.blueprint.palette-equivalent": "{palette.orange.2}"
                    }
                },
                "danger": {
                    "$value": "{intent.danger}",
                    "$extensions": {
                        "com.blueprint.derive": { "lightnessOffset": 0.262, "chromaOffset": -0.066 },
                        "com.blueprint.palette-equivalent": "{palette.red.2}"
                    }
                }
            }
        }
    }
}
