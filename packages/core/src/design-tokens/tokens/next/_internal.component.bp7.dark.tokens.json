{
    "_internal": {
        "component": {
            "button": {
                "background": {
                    "$type": "color",
                    "default": {
                        "disabled": {
                            "$value": "{palette.grey.800}",
                            "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                        },
                        "active-disabled": {
                            "$value": "{palette.grey.900}",
                            "$extensions": { "com.blueprint.derive": { "alpha": 0.7 } }
                        }
                    },
                    "intent": {
                        "primary": {
                            "disabled": {
                                "$value": "{intent.primary.rest}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                            }
                        },
                        "success": {
                            "disabled": {
                                "$value": "{intent.success.rest}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                            }
                        },
                        "warning": {
                            "disabled": {
                                "$value": "{intent.warning.rest}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                            }
                        },
                        "danger": {
                            "disabled": {
                                "$value": "{intent.danger.rest}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                            }
                        }
                    }
                },
                "foreground": {
                    "$type": "color",
                    "default": {
                        "disabled": { "$value": "{palette.grey.300}" }
                    },
                    "intent": {
                        "primary": {
                            "disabled": {
                                "$value": "{intent.primary.foreground}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.4 } }
                            }
                        },
                        "success": {
                            "disabled": {
                                "$value": "{intent.success.foreground}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.4 } }
                            }
                        },
                        "warning": {
                            "disabled": {
                                "$value": "{intent.warning.foreground}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.4 } }
                            }
                        },
                        "danger": {
                            "disabled": {
                                "$value": "{intent.danger.foreground}",
                                "$extensions": { "com.blueprint.derive": { "alpha": 0.4 } }
                            }
                        }
                    }
                },
                "shadow": {
                    "$type": "shadow",
                    "rest": { "$value": "{surface.shadow.1}" },
                    "active": { "$value": "{surface.shadow.0}" }
                }
            }
        }
    }
}
