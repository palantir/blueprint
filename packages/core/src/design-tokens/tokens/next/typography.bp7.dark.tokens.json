{
    "typography": {
        "color": {
            "$type": "color",
            "$description": "Dark-mode text. base is near-white body text (grey.100); intent text references the intent's .200 ramp step.",
            "base": { "$value": "{palette.grey.100}" },
            "intent": {
                "neutral": { "$value": "{intent.neutral.200}" },
                "primary": { "$value": "{intent.primary.200}" },
                "success": { "$value": "{intent.success.200}" },
                "warning": { "$value": "{intent.warning.200}" },
                "danger": { "$value": "{intent.danger.200}" }
            }
        }
    }
}
