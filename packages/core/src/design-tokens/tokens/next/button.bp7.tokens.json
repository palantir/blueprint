{
    "button": {
        "$description": "Public Button appearance and default-size recipe tokens. Intent-specific aliases keep component overrides separate from the global semantic roles.",
        "min-block-size": {
            "$type": "dimension",
            "$value": { "value": 30, "unit": "px" }
        },
        "padding": {
            "$type": "dimension",
            "block": { "$value": { "value": 4, "unit": "px" } },
            "inline": { "$value": { "value": 8, "unit": "px" } }
        },
        "border-radius": {
            "$type": "dimension",
            "$value": "{surface.border-radius}"
        },
        "border-width": {
            "$type": "dimension",
            "solid": { "$value": { "value": 0, "unit": "px" } },
            "outlined": { "$value": "{surface.border-width}" }
        },
        "font-family": {
            "$type": "fontFamily",
            "$value": "{typography.family.body}"
        },
        "font-size": {
            "$type": "dimension",
            "$value": "{typography.size.md}"
        },
        "font-weight": {
            "$type": "fontWeight",
            "$value": "{typography.weight.default}"
        },
        "line-height": {
            "$type": "dimension",
            "$value": { "value": 18, "unit": "px" }
        },
        "icon": {
            "foreground": {
                "$type": "color",
                "default": {
                    "rest": { "$value": "{typography.color.muted}" }
                }
            }
        },
        "background": {
            "$type": "color",
            "default": {
                "rest": { "$value": "{intent.neutral.100}" },
                "hover": { "$value": "{intent.neutral.200}" },
                "active": { "$value": "{intent.neutral.300}" },
                "disabled": {
                    "$value": "{intent.neutral.100}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                },
                "active-disabled": {
                    "$value": "{intent.neutral.300}",
                    "$extensions": { "com.blueprint.derive": { "alpha": 0.7 } }
                }
            },
            "intent": {
                "primary": {
                    "rest": { "$value": "{intent.primary.rest}" },
                    "hover": { "$value": "{intent.primary.hover}" },
                    "active": { "$value": "{intent.primary.active}" },
                    "disabled": {
                        "$value": "{intent.primary.rest}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                    }
                },
                "success": {
                    "rest": { "$value": "{intent.success.rest}" },
                    "hover": { "$value": "{intent.success.hover}" },
                    "active": { "$value": "{intent.success.active}" },
                    "disabled": {
                        "$value": "{intent.success.rest}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                    }
                },
                "warning": {
                    "rest": { "$value": "{intent.warning.rest}" },
                    "hover": { "$value": "{intent.warning.hover}" },
                    "active": { "$value": "{intent.warning.active}" },
                    "disabled": {
                        "$value": "{intent.warning.rest}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                    }
                },
                "danger": {
                    "rest": { "$value": "{intent.danger.rest}" },
                    "hover": { "$value": "{intent.danger.hover}" },
                    "active": { "$value": "{intent.danger.active}" },
                    "disabled": {
                        "$value": "{intent.danger.rest}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.5 } }
                    }
                }
            }
        },
        "foreground": {
            "$type": "color",
            "default": {
                "rest": { "$value": "{typography.color.base}" },
                "disabled": { "$value": "{typography.color.disabled}" }
            },
            "intent": {
                "primary": {
                    "rest": { "$value": "{intent.primary.foreground}" },
                    "disabled": {
                        "$value": "{intent.primary.foreground}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                    }
                },
                "success": {
                    "rest": { "$value": "{intent.success.foreground}" },
                    "disabled": {
                        "$value": "{intent.success.foreground}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                    }
                },
                "warning": {
                    "rest": { "$value": "{intent.warning.foreground}" },
                    "disabled": {
                        "$value": "{intent.warning.foreground}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                    }
                },
                "danger": {
                    "rest": { "$value": "{intent.danger.foreground}" },
                    "disabled": {
                        "$value": "{intent.danger.foreground}",
                        "$extensions": { "com.blueprint.derive": { "alpha": 0.6 } }
                    }
                }
            },
            "minimal": {
                "intent": {
                    "default": {
                        "rest": { "$value": "{button.foreground.default.rest}" },
                        "hover": { "$value": "{button.foreground.default.rest}" },
                        "active": { "$value": "{button.foreground.default.rest}" }
                    },
                    "primary": {
                        "rest": { "$value": "{typography.color.intent.primary}" },
                        "hover": { "$value": "{typography.color.intent.primary}" },
                        "active": { "$value": "{intent.primary.active}" }
                    },
                    "success": {
                        "rest": { "$value": "{typography.color.intent.success}" },
                        "hover": { "$value": "{typography.color.intent.success}" },
                        "active": { "$value": "{intent.success.active}" }
                    },
                    "warning": {
                        "rest": { "$value": "{typography.color.intent.warning}" },
                        "hover": { "$value": "{typography.color.intent.warning}" },
                        "active": { "$value": "{intent.warning.active}" }
                    },
                    "danger": {
                        "rest": { "$value": "{typography.color.intent.danger}" },
                        "hover": { "$value": "{typography.color.intent.danger}" },
                        "active": { "$value": "{intent.danger.active}" }
                    }
                }
            }
        },
        "shadow": {
            "$type": "shadow",
            "rest": { "$value": "{surface.shadow.1}" },
            "active": { "$value": "{surface.shadow.0}" }
        },
        "spinner": {
            "$type": "color",
            "track": { "$value": "{surface.background-color.base.active}" },
            "head": { "$value": "{typography.color.base}" }
        }
    }
}
