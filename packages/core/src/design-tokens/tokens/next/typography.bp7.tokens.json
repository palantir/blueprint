{
    "typography": {
        "family": {
            "$type": "fontFamily",
            "body": {
                "$value": [
                    "-apple-system",
                    "BlinkMacSystemFont",
                    "Segoe UI",
                    "Roboto",
                    "Oxygen",
                    "Ubuntu",
                    "Cantarell",
                    "Open Sans",
                    "Helvetica Neue",
                    "blueprint-icons-16",
                    "sans-serif"
                ]
            },
            "heading": {
                "$description": "Aliases the body family; kept as its own slot so a distinct heading face can be supplied without touching body.",
                "$value": "{typography.family.body}"
            },
            "display": {
                "$description": "Placeholder display face: aliases the body family for now; swap in a dedicated display stack when one is supplied.",
                "$value": "{typography.family.body}"
            },
            "mono": {
                "$value": ["monospace"]
            }
        },
        "size": {
            "$type": "dimension",
            "body-x-small": { "$value": { "value": 9, "unit": "px" } },
            "body-small": { "$value": { "value": 11, "unit": "px" } },
            "body-medium": { "$value": { "value": 13, "unit": "px" } },
            "body-large": { "$value": { "value": 15, "unit": "px" } },
            "heading-small": { "$value": { "value": 16, "unit": "px" } },
            "heading-medium": { "$value": { "value": 20, "unit": "px" } },
            "heading-large": { "$value": { "value": 24, "unit": "px" } },
            "heading-x-large": { "$value": { "value": 28, "unit": "px" } },
            "display": { "$value": { "value": 48, "unit": "px" } },
            "code-x-small": { "$value": { "value": 9, "unit": "px" } },
            "code-small": { "$value": { "value": 10, "unit": "px" } },
            "code-medium": { "$value": { "value": 11, "unit": "px" } },
            "code-large": { "$value": { "value": 14, "unit": "px" } }
        },
        "weight": {
            "$type": "fontWeight",
            "default": { "$value": 400 },
            "strong": { "$value": 500 }
        },
        "line-height": {
            "$type": "number",
            "running-factor": {
                "$value": 1.105,
                "$description": "Multiplier applied to a style's standard line-height for multi-line running/body text (midpoint of the former per-size running ratios). Components/users stack their own line-height scaling on top."
            }
        },
        "styles": {
            "$description": "Composite text styles. Per-group constants (fontFamily, fontWeight, letterSpacing) are declared once on the group and reference the primitives above; each size supplies only fontSize and its standard (tight) lineHeight. For multi-line prose, multiply lineHeight by line-height.running-factor.",
            "code": {
                "fontFamily": { "$type": "fontFamily", "$value": "{typography.family.mono}" },
                "fontWeight": { "$type": "fontWeight", "$value": "{typography.weight.default}" },
                "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
                "x-small": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.code-x-small}" },
                    "lineHeight": { "$type": "number", "$value": 1.66667 }
                },
                "small": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.code-small}" },
                    "lineHeight": { "$type": "number", "$value": 1.5 }
                },
                "medium": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.code-medium}" },
                    "lineHeight": { "$type": "number", "$value": 1.81818 }
                },
                "large": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.code-large}" },
                    "lineHeight": { "$type": "number", "$value": 1.5 }
                }
            },
            "body": {
                "fontFamily": { "$type": "fontFamily", "$value": "{typography.family.body}" },
                "fontWeight": { "$type": "fontWeight", "$value": "{typography.weight.default}" },
                "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
                "x-small": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.body-x-small}" },
                    "lineHeight": { "$type": "number", "$value": 1.66667 }
                },
                "small": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.body-small}" },
                    "lineHeight": { "$type": "number", "$value": 1.63636 }
                },
                "medium": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.body-medium}" },
                    "lineHeight": { "$type": "number", "$value": 1.38462 }
                },
                "large": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.body-large}" },
                    "lineHeight": { "$type": "number", "$value": 1.33333 }
                }
            },
            "heading": {
                "fontFamily": { "$type": "fontFamily", "$value": "{typography.family.heading}" },
                "fontWeight": { "$type": "fontWeight", "$value": "{typography.weight.strong}" },
                "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
                "small": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.heading-small}" },
                    "lineHeight": { "$type": "number", "$value": 1.25 }
                },
                "medium": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.heading-medium}" },
                    "lineHeight": { "$type": "number", "$value": 1.1 }
                },
                "large": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.heading-large}" },
                    "lineHeight": { "$type": "number", "$value": 1.08333 }
                },
                "x-large": {
                    "fontSize": { "$type": "dimension", "$value": "{typography.size.heading-x-large}" },
                    "lineHeight": { "$type": "number", "$value": 1.07143 }
                }
            },
            "display": {
                "fontFamily": { "$type": "fontFamily", "$value": "{typography.family.display}" },
                "fontWeight": { "$type": "fontWeight", "$value": "{typography.weight.default}" },
                "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
                "fontSize": { "$type": "dimension", "$value": "{typography.size.display}" },
                "lineHeight": { "$type": "number", "$value": 1.16667 }
            }
        },
        "color": {
            "$type": "color",
            "$description": "base is the near-black body text (palette grey.1000); intent text references the intent's .600 ramp step.",
            "base": { "$value": "{palette.grey.1000}" },
            "intent": {
                "neutral": { "$value": "{intent.neutral.600}" },
                "primary": { "$value": "{intent.primary.600}" },
                "success": { "$value": "{intent.success.600}" },
                "warning": { "$value": "{intent.warning.600}" },
                "danger": { "$value": "{intent.danger.600}" }
            }
        }
    }
}
