# Figma Personal Access Token
# Get your token from: https://www.figma.com/settings (Personal access tokens section)
# This token is used to fetch icon data from Figma if you need to update icons
FIGMA_PERSONAL_ACCESS_TOKEN=your_figma_token_here

# Optional: Figma File ID (if you need to fetch from a specific file)
# FIGMA_FILE_ID=your_file_id_here
